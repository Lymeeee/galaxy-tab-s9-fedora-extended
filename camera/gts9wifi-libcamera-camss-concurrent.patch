+/*
+ * Return the VFE index encoded in a CAMSS RDI video entity name
+ * ("msm_vfe<index>_rdi<channel>").  Each VFE has a single CSID input, so two
+ * cameras must not share a VFE even when their RDI channels differ.
+ */
+bool camssVfeIndexOf(const std::string &name, unsigned int &vfe)
+{
+	static const std::string prefix = "msm_vfe";
+
+	if (name.compare(0, prefix.size(), prefix) != 0)
+		return false;
+
+	size_t pos = prefix.size();
+	size_t end = name.find('_', pos);
+	if (end == std::string::npos || end == pos)
+		return false;
+
+	unsigned int index = 0;
+	for (size_t i = pos; i < end; ++i) {
+		if (name[i] < '0' || name[i] > '9')
+			return false;
+		index = index * 10 + name[i] - '0';
+	}
+
+	vfe = index;
+	return true;
+}
+
