+SimplePipelineHandler::~SimplePipelineHandler()
+{
+	/*
+	 * CAMSS leaves the media links enabled.  A process that only enumerated
+	 * the cameras would otherwise force the next process onto another
+	 * CSID/VFE path on every run.  Only links enabled by this handler are
+	 * tracked, so streams owned by other processes are left untouched.
+	 */
+	for (MediaLink *link : camssLinks_)
+		link->setEnabled(false);
+}
