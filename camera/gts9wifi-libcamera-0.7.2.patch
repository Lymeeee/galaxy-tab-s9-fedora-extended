+void IPASoftSimple::startFocusScan(bool retry)
+{
+	if (!retry)
+		afFailedScans_ = 0;
+	afPhase_ = AfPhase::Coarse;
+	afState_ = controls::AfStateScanning;
+	afPositions_ = { 128, 256, 384, 512, 640, 768, 896 };
+	afPositionCount_ = afPositions_.size();
+	afPositionIndex_ = 0;
+	afSettleStats_ = 1;
+	afLockedStats_ = 0;
+	afDropStats_ = 0;
+	afBestPosition_ = 512;
+	afBestScore_ = 0;
+	afMinScore_ = std::numeric_limits<uint64_t>::max();
+}
+
+std::optional<int32_t> IPASoftSimple::processFocusStats(uint64_t score)
+{
+	if (afPhase_ == AfPhase::Idle)
+		return std::nullopt;
+
+	if (afPhase_ == AfPhase::Locked) {
+		/* A single-shot AF request must remain locked until retriggered. */
+		if (afMode_ != controls::AfModeContinuous)
+			return std::nullopt;
+		if (afSettleStats_) {
+			afSettleStats_--;
+			return std::nullopt;
+		}
+		afLockedStats_++;
+		/* Contrast can rise as well as fall after a scene change. */
+		if (afLockedScore_ &&
+		    (score * 4 < afLockedScore_ * 3 ||
+		     score * 4 > afLockedScore_ * 5))
+			afDropStats_++;
+		else
+			afDropStats_ = 0;
+
+		if (afState_ == controls::AfStateFailed &&
+		    afLockedStats_ >= 15 && afFailedScans_ < 3)
+			startFocusScan(true);
+		else if (afDropStats_ >= 3)
+			startFocusScan();
+		else if (afLockedStats_ >= 45) {
+			/* Periodically check nearby focus without a full-range hunt.
+			 * This also detects depth changes with similar scene contrast.
+			 * Statistics arrive only while capture is running.
+			 */
+			afPhase_ = AfPhase::Probe;
+			afProbePosition_ = afPosition_;
+			afPositions_[0] = afPosition_;
+			afPositions_[1] = std::max(afPosition_ - 48, 0);
+			afPositions_[2] = std::min(afPosition_ + 48, 1023);
+			afPositionCount_ = 3;
+			afPositionIndex_ = 0;
+			afBestScore_ = 0;
+			afBestPosition_ = afPosition_;
+		}
+		else
+			return std::nullopt;
+	}
+
+	if (afSettleStats_) {
+		afSettleStats_--;
+		if (afPosition_ != afPositions_[afPositionIndex_]) {
+			afPosition_ = afPositions_[afPositionIndex_];
+			afSettleStats_ = 1;
+			return afPosition_;
+		}
+		return std::nullopt;
+	}
+
+	if (afPhase_ == AfPhase::Probe && !afPositionIndex_)
+		afProbeScore_ = score;
+	if (afPhase_ != AfPhase::Probe)
+		afMinScore_ = std::min(afMinScore_, score);
+
+	if (score > afBestScore_) {
+		afBestScore_ = score;
+		afBestPosition_ = afPosition_;
+	}
+
+	afPositionIndex_++;
+	if (afPositionIndex_ < afPositionCount_) {
+		afSettleStats_ = 1;
+		afPosition_ = afPositions_[afPositionIndex_];
+		return afPosition_;
+	}
+
+	if (afPhase_ == AfPhase::Probe) {
+		if (afBestScore_ > afProbeScore_ + afProbeScore_ / 10) {
+			startFocusScan();
+			return std::nullopt;
+		}
+		/* No clear improvement: retain the original focus, not noise. */
+		afBestPosition_ = afProbePosition_;
+		afBestScore_ = afProbeScore_;
+	}
+
+	if (afPhase_ == AfPhase::Coarse) {
+		afPhase_ = AfPhase::Fine;
+		afPositionCount_ = 5;
+		afPositionIndex_ = 0;
+		afBestScore_ = 0;
+		for (unsigned int i = 0; i < afPositionCount_; ++i) {
+			int32_t offset = (static_cast<int32_t>(i) - 2) * 48;
+			afPositions_[i] = std::clamp(afBestPosition_ + offset, 0, 1023);
+		}
+		afSettleStats_ = 1;
+		afPosition_ = afPositions_[0];
+		return afPosition_;
+	}
+
+	/* A nearly flat contrast curve is not evidence of optical focus.
+	 * Motion or noise can otherwise select an arbitrary lens position and
+	 * keep it indefinitely. Retry uncertain scans, with a bounded budget.
+	 */
+	bool focused = afPhase_ == AfPhase::Probe
+		? afState_ == controls::AfStateFocused
+		: afBestScore_ > afMinScore_ + afMinScore_ / 12;
+	if (afPhase_ != AfPhase::Probe && !focused)
+		afFailedScans_++;
+	afPhase_ = AfPhase::Locked;
+	afState_ = focused ? controls::AfStateFocused : controls::AfStateFailed;
+	afLockedScore_ = afBestScore_;
+	afLockedStats_ = 0;
+	afDropStats_ = 0;
+	afPosition_ = afBestPosition_;
+	afSettleStats_ = 1;
+	return afPosition_;
+}
