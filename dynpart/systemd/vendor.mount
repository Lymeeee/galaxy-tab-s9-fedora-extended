[Unit]
Description=Stock Android vendor partition (super)
Requires=gts9wifi-android-parts.service
After=gts9wifi-android-parts.service
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target

[Mount]
What=/dev/mapper/vendor
Where=/vendor
Type=auto
Options=ro

[Install]
WantedBy=multi-user.target
