#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Pair the docked S Pen over BLE and publish its battery through BlueZ."""

import fcntl
import glob
import math
import os
import struct
import sys
import time
from pathlib import Path

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BLUEZ = "org.bluez"
DEVICE_IFACE = "org.bluez.Device1"
ADAPTER_IFACE = "org.bluez.Adapter1"
GATT_IFACE = "org.bluez.GattCharacteristic1"
PROPERTIES_IFACE = "org.freedesktop.DBus.Properties"
MANAGER_IFACE = "org.freedesktop.DBus.ObjectManager"
BATTERY_IFACE = "org.bluez.BatteryProvider1"

SERVICE_PATH = "/org/gts9wifi/SPenRemote"
AGENT_PATH = SERVICE_PATH + "/agent"
BATTERY_ROOT = SERVICE_PATH + "/battery"

DOCK_GLOB = "/sys/bus/i2c/devices/*/pen_docked"
RESET_GLOB = "/sys/bus/i2c/devices/*/pen_ble_reset"
SPEN_SERVICES = {
    "0000fd6c-0000-1000-8000-00805f9b34fb",
    "0000fef5-0000-1000-8000-00805f9b34fb",
}
BATTERY_UUID = "5a87b4ef-3bfa-76a8-e642-92933c31434f"
MODE_UUID = "aca1ab48-08ba-e79e-ab48-a9b9e6429293"
BATTERY_STATE = "/run/gts9wifi/spen-battery"
BUTTON_UUID = "6c290d2e-1c03-aca1-ab48-a9b908bae79e"
RAW_SENSOR_UUID = "ddb42396-ca00-4db3-b87d-2ee458279360"
AIRMOUSE_STATE = Path('/etc/gts9wifi/spen-airmouse')

EV_SYN = 0
EV_KEY = 1
EV_REL = 2
SYN_REPORT = 0
REL_X = 0
REL_Y = 1
BTN_LEFT = 272
BTN_TOOL_PEN = 320
BTN_STYLUS = 331
BUS_VIRTUAL = 0x06
INPUT_EVENT = struct.Struct('llHHi')
UI_SET_EVBIT = 0x40045564
UI_SET_KEYBIT = 0x40045565
UI_SET_RELBIT = 0x40045566
UI_DEV_CREATE = 0x5501
UI_DEV_DESTROY = 0x5502
UI_DEV_SETUP = 0x405c5503
EVIOCGKEY = 0x80004518

PAIR_WINDOW_SECONDS = 65
PAIR_ATTEMPTS = 2
CONNECT_TIMEOUT_SECONDS = 12
CONNECT_INTERVAL_SECONDS = 8
BATTERY_PERIOD_SECONDS = 30


def read_sysfs(pattern):
    for path in glob.glob(pattern):
        try:
            return Path(path).read_text(encoding="ascii").strip()
        except OSError:
            continue
    return None


def docked():
    return read_sysfs(DOCK_GLOB) == "1"


def publish_battery_state(percentage):
    try:
        path = Path(BATTERY_STATE)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f"{percentage}\n", encoding="ascii")
    except OSError:
        pass


def reset_path():
    paths = glob.glob(RESET_GLOB)
    return Path(paths[0]) if paths else None


def is_spen_name(properties):
    name = str(properties.get("Alias") or properties.get("Name") or "")
    return name.startswith("SPEN")


def is_spen(properties):
    services = {str(uuid).lower() for uuid in properties.get("UUIDs", [])}
    return is_spen_name(properties) and SPEN_SERVICES <= services


def airmouse_enabled():
    return AIRMOUSE_STATE.exists()


class VirtualPointer:
    """Relative pointer fed by the S Pen's BLE gyroscope deltas."""

    def __init__(self):
        self.fd = os.open("/dev/uinput", os.O_RDWR | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_REL)
        fcntl.ioctl(self.fd, UI_SET_KEYBIT, BTN_LEFT)
        fcntl.ioctl(self.fd, UI_SET_RELBIT, REL_X)
        fcntl.ioctl(self.fd, UI_SET_RELBIT, REL_Y)
        name = b"Galaxy Tab S9 S Pen pointer".ljust(80, b"\0")
        setup = struct.pack("HHHH80sI", BUS_VIRTUAL, 0x04E8, 0xA037, 1, name, 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, event_type, code, value):
        os.write(self.fd, INPUT_EVENT.pack(0, 0, event_type, code, value))

    def move(self, dx, dy):
        if dx:
            self.emit(EV_REL, REL_X, dx)
        if dy:
            self.emit(EV_REL, REL_Y, dy)
        if dx or dy:
            self.emit(EV_SYN, SYN_REPORT, 0)

    def button(self, pressed):
        self.emit(EV_KEY, BTN_LEFT, int(pressed))
        self.emit(EV_SYN, SYN_REPORT, 0)

    def close(self):
        if self.fd is not None:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
            os.close(self.fd)
            self.fd = None


class BatteryObject(dbus.service.Object):
    def __init__(self, conn, provider):
        super().__init__(conn, BATTERY_ROOT + "/pen")
        self.provider = provider

    @dbus.service.method(PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        return (self.provider.values or {}) if interface == BATTERY_IFACE else {}

    @dbus.service.method(PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface, name):
        values = self.GetAll(interface)
        if name not in values:
            raise dbus.exceptions.DBusException(
                "Unknown battery property",
                name="org.freedesktop.DBus.Error.InvalidArgs",
            )
        return values[name]

    @dbus.service.signal(PROPERTIES_IFACE, signature="sa{sv}as")
    def PropertiesChanged(self, interface, values, invalidated):
        pass


class BatteryProvider(dbus.service.Object):
    """Publish Samsung's custom GATT battery as a BlueZ battery provider."""

    def __init__(self, bus):
        super().__init__(bus, BATTERY_ROOT)
        self.bus = bus
        self.values = None
        self.adapter = None
        self.registered = False
        self.registering = False
        self.retry_at = 0
        self.child = BatteryObject(bus, self)

    @dbus.service.method(MANAGER_IFACE, out_signature="a{oa{sa{sv}}}")
    def GetManagedObjects(self):
        return (
            {BATTERY_ROOT + "/pen": {BATTERY_IFACE: self.values}}
            if self.values is not None
            else {}
        )

    @dbus.service.signal(MANAGER_IFACE, signature="oa{sa{sv}}")
    def InterfacesAdded(self, path, interfaces):
        pass

    @dbus.service.signal(MANAGER_IFACE, signature="oas")
    def InterfacesRemoved(self, path, interfaces):
        pass

    def update(self, device, percentage):
        if not device or percentage is None or not 0 <= percentage <= 100:
            if self.values is not None:
                self.InterfacesRemoved(BATTERY_ROOT + "/pen", [BATTERY_IFACE])
            self.values = None
            return

        publish_battery_state(percentage)
        adapter = str(device).rsplit("/dev_", 1)[0]
        if not self.registered and not self.registering and \
                time.monotonic() >= self.retry_at:
            self.adapter = adapter
            self.registering = True
            try:
                manager = dbus.Interface(
                    self.bus.get_object(BLUEZ, adapter),
                    "org.bluez.BatteryProviderManager1",
                )
                manager.RegisterBatteryProvider(
                    BATTERY_ROOT,
                    reply_handler=self._registered,
                    error_handler=self._failed,
                )
            except dbus.DBusException as error:
                self._failed(error)

        values = {
            "Device": dbus.ObjectPath(device),
            "Percentage": dbus.Byte(percentage),
            "Source": dbus.String("Samsung S Pen"),
        }
        if values == self.values:
            return
        previous = self.values
        if previous is not None and previous["Device"] != values["Device"]:
            self.InterfacesRemoved(BATTERY_ROOT + "/pen", [BATTERY_IFACE])
            previous = None
        self.values = values
        if previous is None:
            if self.registered:
                self.InterfacesAdded(
                    BATTERY_ROOT + "/pen", {BATTERY_IFACE: values}
                )
        else:
            self.child.PropertiesChanged(BATTERY_IFACE, values, [])

    def _registered(self):
        self.registering = False
        self.registered = True
        if self.values is not None:
            self.InterfacesAdded(
                BATTERY_ROOT + "/pen", {BATTERY_IFACE: self.values}
            )

    def _failed(self, error):
        self.registering = False
        self.registered = False
        self.retry_at = time.monotonic() + 60
        print(f"S Pen battery provider unavailable: {error}", flush=True)


class Agent(dbus.service.Object):
    def __init__(self, conn, service):
        super().__init__(conn, AGENT_PATH)
        self.service = service

    def _accept(self, device):
        properties = self.service.devices().get(device)
        if properties is None or not is_spen(properties) or not docked() or \
                not (properties.get("Paired", False) or self.service.pairing):
            raise dbus.DBusException(
                "Pairing request is not from the docked S Pen",
                name="org.bluez.Error.Rejected",
            )

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        self._accept(device)
        return "0000"

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        self._accept(device)
        return dbus.UInt32(0)

    @dbus.service.method("org.bluez.Agent1", in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, _passkey, _entered):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def DisplayPinCode(self, device, _pincode):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, _passkey):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, _uuid):
        self._accept(device)

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        pass


class Service(dbus.service.Object):
    def __init__(self, bus):
        self.bus = bus
        self.manager = dbus.Interface(
            bus.get_object(BLUEZ, "/"), MANAGER_IFACE
        )
        objects = self.manager.GetManagedObjects()
        self.adapter_path = next(
            path for path, interfaces in objects.items()
            if ADAPTER_IFACE in interfaces
        )
        adapter_object = bus.get_object(BLUEZ, self.adapter_path)
        self.adapter = dbus.Interface(adapter_object, ADAPTER_IFACE)
        self.adapter_properties = dbus.Interface(adapter_object, PROPERTIES_IFACE)
        self.agent_manager = dbus.Interface(
            bus.get_object(BLUEZ, "/org/bluez"), "org.bluez.AgentManager1"
        )
        super().__init__(bus, SERVICE_PATH)
        self.agent = Agent(bus, self)
        self.battery = BatteryProvider(bus)

        self.pairing = False
        self.pairing_deadline = 0.0
        self.pairing_attempts = 0
        self.pairing_attempted = False
        self.next_pair_at = 0.0
        self.agent_registered = False
        self.pairable_before = False
        self.started_discovery = False
        self.dock_seen = False
        self.connecting = set()
        self.connect_failures = {}
        self.last_connect_at = 0.0
        self.repairs = 0
        self.ble_device_path = None
        self.ble_chars = {}
        self.ble_notify = set()
        self.mode_value = None
        self.battery_valid = False
        self.next_battery_at = 0.0
        self.virtual_pointer = None
        self.pen_fd = None
        self.pen_watch = None
        self.pen_in_proximity = False
        self.pen_pressed = False
        self.pointer_filtered_x = 0.0
        self.pointer_filtered_y = 0.0
        self.pointer_residual_x = 0.0
        self.pointer_residual_y = 0.0
        self.pointer_gravity_y = None
        self.pointer_gravity_z = None
        self.bus.add_signal_receiver(
            self._gatt_properties,
            signal_name="PropertiesChanged",
            dbus_interface=PROPERTIES_IFACE,
            path_keyword="path",
        )

    def devices(self):
        try:
            return {
                path: interfaces[DEVICE_IFACE]
                for path, interfaces in self.manager.GetManagedObjects().items()
                if DEVICE_IFACE in interfaces
            }
        except dbus.DBusException:
            return {}

    def paired_spen(self):
        for path, properties in self.devices().items():
            if properties.get("Paired", False) and is_spen_name(properties):
                return path, properties
        return None, None

    def set_trusted(self, path):
        properties = self.devices().get(path)
        if properties is None or properties.get("Trusted", False):
            return
        try:
            dbus.Interface(
                self.bus.get_object(BLUEZ, path), PROPERTIES_IFACE
            ).Set(DEVICE_IFACE, "Trusted", dbus.Boolean(True))
        except dbus.DBusException as error:
            print(f"Could not trust S Pen: {error.get_dbus_name()}", flush=True)

    def register_agent(self):
        if self.agent_registered:
            return
        self.agent_manager.RegisterAgent(AGENT_PATH, "DisplayYesNo")
        self.agent_manager.RequestDefaultAgent(AGENT_PATH)
        self.agent_registered = True

    def begin_pairing(self):
        path = reset_path()
        if path is None:
            print("S Pen reset sysfs is missing; kernel support not ready",
                  flush=True)
            self.pairing_attempted = True
            return
        self.pairable_before = bool(
            self.adapter_properties.Get(ADAPTER_IFACE, "Pairable")
        )
        self.adapter_properties.Set(ADAPTER_IFACE, "Powered", dbus.Boolean(True))
        self.adapter_properties.Set(ADAPTER_IFACE, "Pairable", dbus.Boolean(True))
        try:
            self.register_agent()
        except dbus.DBusException as error:
            print(f"Could not register pairing agent: {error}", flush=True)
            self.pairing_attempted = True
            return
        try:
            self.adapter.StartDiscovery()
            self.started_discovery = True
        except dbus.DBusException as error:
            if error.get_dbus_name() != "org.bluez.Error.InProgress":
                print(f"Could not start discovery: {error}", flush=True)
        try:
            path.write_text("1\n", encoding="ascii")
        except OSError as error:
            print(f"S Pen pairing reset failed: {error}", flush=True)
            self.finish_pairing()
            self.pairing_attempted = True
            return
        self.pairing = True
        self.pairing_deadline = time.monotonic() + PAIR_WINDOW_SECONDS
        self.pairing_attempts += 1
        print("S Pen dock pairing window started", flush=True)

    def finish_pairing(self):
        if self.started_discovery:
            try:
                self.adapter.StopDiscovery()
            except dbus.DBusException:
                pass
            self.started_discovery = False
        if self.pairing:
            try:
                self.adapter_properties.Set(
                    ADAPTER_IFACE, "Pairable", dbus.Boolean(self.pairable_before)
                )
            except dbus.DBusException:
                pass
        self.pairing = False
        self.pairing_deadline = 0.0
        if self.agent_registered:
            try:
                self.agent_manager.UnregisterAgent(AGENT_PATH)
            except dbus.DBusException:
                pass
            self.agent_registered = False

    def connect(self, path):
        now = time.monotonic()
        if path in self.connecting or now < self.last_connect_at:
            return
        self.last_connect_at = now + CONNECT_INTERVAL_SECONDS
        self.connecting.add(path)

        def finished(*_args):
            self.connecting.discard(path)
            self.connect_failures.pop(path, None)

        def failed(error):
            self.connecting.discard(path)
            name = error.get_dbus_name()
            if name in {
                "org.bluez.Error.AlreadyConnected",
                "org.bluez.Error.InProgress",
            }:
                return
            print(f"S Pen connect failed: {name}", flush=True)
            failures = self.connect_failures.get(path, 0) + 1
            self.connect_failures[path] = failures
            if failures >= 2 and docked():
                self.repair_bond(path)

        dbus.Interface(
            self.bus.get_object(BLUEZ, path), DEVICE_IFACE
        ).Connect(
            reply_handler=finished,
            error_handler=failed,
            timeout=CONNECT_TIMEOUT_SECONDS,
        )

    def repair_bond(self, path):
        if self.repairs >= 1:
            self.pairing_attempted = True
            print("S Pen bond repair already tried; reinsert the pen to retry",
                  flush=True)
            return
        self.repairs += 1
        print("Replacing stale S Pen bond", flush=True)
        self.pairing_attempted = False
        self.pairing_attempts = 0
        self.next_pair_at = time.monotonic() + 2

        def removed(*_args):
            print("Stale S Pen bond removed", flush=True)

        def failed(error):
            print(f"Could not remove S Pen bond: {error.get_dbus_name()}",
                  flush=True)

        try:
            self.adapter.RemoveDevice(
                dbus.ObjectPath(path),
                reply_handler=removed,
                error_handler=failed,
            )
        except dbus.DBusException as error:
            failed(error)

    def consider(self, path, properties):
        if properties.get("Paired", False):
            if not is_spen_name(properties):
                return
            self.set_trusted(path)
            if self.pairing:
                self.finish_pairing()
            if docked() and not properties.get("Connected", False):
                self.connect(path)
            return
        if is_spen(properties) and self.pairing and docked():
            self.connect(path)

    def refresh_gatt(self, path, now):
        try:
            objects = self.manager.GetManagedObjects()
        except dbus.DBusException:
            self.battery.update(None, None)
            return
        properties = objects.get(path, {}).get(DEVICE_IFACE, {})
        if not properties.get("Connected", False) or \
                not properties.get("ServicesResolved", False):
            self.battery.update(None, None)
            self.ble_chars = {}
            self.ble_notify.clear()
            self.mode_value = None
            self.battery_valid = False
            return

        if self.ble_device_path != path:
            self.ble_device_path = path
            self.ble_chars = {}
            self.ble_notify.clear()
            self.mode_value = None
            self.battery_valid = False
            self.next_battery_at = 0.0

        chars = {}
        for object_path, interfaces in objects.items():
            if object_path.startswith(path + "/") and GATT_IFACE in interfaces:
                chars[str(interfaces[GATT_IFACE]["UUID"]).lower()] = object_path
        self.ble_chars = chars

        pointer_active = airmouse_enabled() and not docked()
        desired_mode = 0x04 if pointer_active else 0x10

        raw_path = chars.get(RAW_SENSOR_UUID)
        if pointer_active and raw_path is not None:
            if raw_path not in self.ble_notify:
                try:
                    dbus.Interface(
                        self.bus.get_object(BLUEZ, raw_path), GATT_IFACE
                    ).StartNotify()
                    self.ble_notify.add(raw_path)
                except dbus.DBusException:
                    pass
        elif raw_path is not None and raw_path in self.ble_notify:
            try:
                dbus.Interface(
                    self.bus.get_object(BLUEZ, raw_path), GATT_IFACE
                ).StopNotify()
            except dbus.DBusException:
                pass
            self.ble_notify.discard(raw_path)

        button_path = chars.get(BUTTON_UUID)
        if pointer_active and button_path is not None:
            if button_path not in self.ble_notify:
                try:
                    dbus.Interface(
                        self.bus.get_object(BLUEZ, button_path), GATT_IFACE
                    ).StartNotify()
                    self.ble_notify.add(button_path)
                except dbus.DBusException:
                    pass
        elif button_path is not None and button_path in self.ble_notify:
            try:
                dbus.Interface(
                    self.bus.get_object(BLUEZ, button_path), GATT_IFACE
                ).StopNotify()
            except dbus.DBusException:
                pass
            self.ble_notify.discard(button_path)

        mode_path = chars.get(MODE_UUID)
        if mode_path is not None and self.mode_value != desired_mode:
            try:
                dbus.Interface(
                    self.bus.get_object(BLUEZ, mode_path), GATT_IFACE
                ).WriteValue(
                    dbus.Array([dbus.Byte(desired_mode)], signature="y"), {}
                )
                self.mode_value = desired_mode
            except dbus.DBusException:
                self.mode_value = None

        battery_path = chars.get(BATTERY_UUID)
        if battery_path is None:
            self.battery_valid = False
            self.battery.update(None, None)
            return
        if battery_path not in self.ble_notify:
            try:
                dbus.Interface(
                    self.bus.get_object(BLUEZ, battery_path), GATT_IFACE
                ).StartNotify()
                self.ble_notify.add(battery_path)
            except dbus.DBusException:
                pass

        if now < self.next_battery_at:
            return
        self.next_battery_at = now + BATTERY_PERIOD_SECONDS
        try:
            value = dbus.Interface(
                self.bus.get_object(BLUEZ, battery_path), GATT_IFACE
            ).ReadValue({})
        except dbus.DBusException:
            self.battery_valid = False
            self.battery.update(None, None)
            return
        if value and int(value[0]) <= 100:
            self.battery_valid = True
            self.battery.update(path, int(value[0]))
        else:
            self.battery_valid = False
            self.battery.update(None, None)

    def sync_pointer(self):
        wanted = airmouse_enabled() and not docked()
        if wanted:
            if self.virtual_pointer is None:
                try:
                    self.virtual_pointer = VirtualPointer()
                except OSError:
                    self.virtual_pointer = None
            return
        if self.virtual_pointer is None:
            return
        if self.pen_pressed:
            self.virtual_pointer.button(False)
            self.pen_pressed = False
        self.virtual_pointer.close()
        self.virtual_pointer = None

    @staticmethod
    def find_pen_event():
        for event in glob.glob("/sys/class/input/event*"):
            try:
                name = Path(event, "device/name").read_text(
                    encoding="ascii").strip()
            except OSError:
                continue
            if "Wacom" in name and "Pen" in name:
                return "/dev/input/" + Path(event).name
        return None

    def ensure_pen_reader(self):
        if not airmouse_enabled():
            self.close_pen_reader()
            return
        if self.pen_fd is not None:
            return
        path = self.find_pen_event()
        if path is None:
            return
        try:
            self.pen_fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            keys = bytearray(BTN_TOOL_PEN // 8 + 1)
            fcntl.ioctl(self.pen_fd, EVIOCGKEY | (len(keys) << 16), keys, True)
            self.pen_in_proximity = bool(
                keys[BTN_TOOL_PEN // 8] & (1 << (BTN_TOOL_PEN % 8))
            )
        except OSError:
            self.pen_in_proximity = True
            self.close_pen_reader()
            return
        self.pen_watch = GLib.io_add_watch(
            self.pen_fd, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._pen_event
        )

    def close_pen_reader(self):
        if self.pen_pressed and self.virtual_pointer is not None:
            self.virtual_pointer.button(False)
            self.pen_pressed = False
        if self.pen_watch is not None:
            GLib.source_remove(self.pen_watch)
            self.pen_watch = None
        if self.pen_fd is not None:
            self.pen_in_proximity = True
            os.close(self.pen_fd)
            self.pen_fd = None

    def _pen_event(self, _source, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.close_pen_reader()
            return GLib.SOURCE_REMOVE
        try:
            data = os.read(self.pen_fd, INPUT_EVENT.size * 32)
        except BlockingIOError:
            return GLib.SOURCE_CONTINUE
        except OSError:
            self.close_pen_reader()
            return GLib.SOURCE_REMOVE
        if not data:
            self.close_pen_reader()
            return GLib.SOURCE_REMOVE
        for offset in range(0, len(data) - INPUT_EVENT.size + 1,
                            INPUT_EVENT.size):
            _sec, _usec, event_type, code, value = INPUT_EVENT.unpack_from(
                data, offset)
            if event_type == EV_KEY and code == BTN_TOOL_PEN and value in {0, 1}:
                self.pen_in_proximity = value == 1
            elif event_type == EV_KEY and code == BTN_STYLUS and value in {0, 1}:
                self._pen_button(value == 1)
        return GLib.SOURCE_CONTINUE

    def _pen_button(self, pressed):
        if not airmouse_enabled() or self.virtual_pointer is None:
            return
        if pressed == self.pen_pressed:
            return
        self.pen_pressed = pressed
        self.virtual_pointer.button(pressed)

    def _gatt_properties(self, interface, changed, _invalidated, path=None):
        if interface != GATT_IFACE or "Value" not in changed:
            return
        value = bytes(changed["Value"])
        if path == self.ble_chars.get(RAW_SENSOR_UUID):
            self._raw_sensor(value)
        elif path == self.ble_chars.get(BUTTON_UUID):
            self._button_data(value)

    def _raw_sensor(self, value):
        if not airmouse_enabled() or self.virtual_pointer is None or docked():
            return
        if len(value) < 13:
            return
        accel_y = int.from_bytes(value[3:5], "little", signed=True)
        accel_z = int.from_bytes(value[5:7], "little", signed=True)
        gyro_y = int.from_bytes(value[9:11], "little", signed=True)
        gyro_z = int.from_bytes(value[11:13], "little", signed=True)
        gravity_norm = math.hypot(accel_y, accel_z)
        if gravity_norm >= 500:
            target_y = accel_y / gravity_norm
            target_z = accel_z / gravity_norm
            if self.pointer_gravity_y is None:
                self.pointer_gravity_y = target_y
                self.pointer_gravity_z = target_z
            else:
                self.pointer_gravity_y += 0.12 * (
                    target_y - self.pointer_gravity_y)
                self.pointer_gravity_z += 0.12 * (
                    target_z - self.pointer_gravity_z)
                norm = math.hypot(
                    self.pointer_gravity_y, self.pointer_gravity_z)
                self.pointer_gravity_y /= norm
                self.pointer_gravity_z /= norm
        if self.pointer_gravity_y is None:
            return
        yaw = gyro_y * self.pointer_gravity_y + gyro_z * self.pointer_gravity_z
        pitch = -gyro_y * self.pointer_gravity_z + gyro_z * self.pointer_gravity_y
        if abs(yaw) < 120:
            yaw = 0
        if abs(pitch) < 120:
            pitch = 0
        self._pointer_move(yaw, pitch)

    def _button_data(self, value):
        if not airmouse_enabled() or self.virtual_pointer is None:
            return
        offset = 0
        count = 1
        if len(value) >= 2 and value[0] == 0xF0:
            count = value[1]
            offset = 2
        for _index in range(count):
            if offset >= len(value):
                break
            header = value[offset]
            if header == 3:
                if not self.pen_pressed:
                    self.pen_pressed = True
                    self.virtual_pointer.button(True)
                offset += 1
            elif header == 0 and offset + 6 <= len(value):
                if self.pen_pressed:
                    self.virtual_pointer.button(False)
                self.pen_pressed = False
                offset += 6
            elif header in {14, 15, 142, 143} and offset + 6 <= len(value):
                dx = int.from_bytes(
                    value[offset + 1:offset + 3], "little", signed=True)
                dy = int.from_bytes(
                    value[offset + 3:offset + 5], "little", signed=True)
                pressed = header in {15, 143}
                if pressed != self.pen_pressed:
                    self.pen_pressed = pressed
                    self.virtual_pointer.button(pressed)
                self._pointer_move(dx, dy)
                offset += 6
            else:
                break

    def _pointer_move(self, raw_x, raw_y):
        if self.virtual_pointer is None:
            return
        scale = 0.0045 * (
            1.0 + min(1.5, (abs(raw_x) + abs(raw_y)) / 6000.0))
        target_x = -raw_x * scale * 1.6
        target_y = raw_y * scale
        alpha = 1.0 - 35 / 110.0
        self.pointer_filtered_x += alpha * (target_x - self.pointer_filtered_x)
        self.pointer_filtered_y += alpha * (target_y - self.pointer_filtered_y)
        self.pointer_residual_x += self.pointer_filtered_x
        self.pointer_residual_y += self.pointer_filtered_y
        move_x = int(self.pointer_residual_x)
        move_y = int(self.pointer_residual_y)
        self.pointer_residual_x -= move_x
        self.pointer_residual_y -= move_y
        self.virtual_pointer.move(move_x, move_y)

    def tick(self):
        now = time.monotonic()
        is_docked = docked()
        enabled = airmouse_enabled()
        self.sync_pointer()
        if enabled:
            self.ensure_pen_reader()
        else:
            self.close_pen_reader()

        if not is_docked:
            if self.pairing:
                self.finish_pairing()
            self.dock_seen = False
            self.pairing_attempted = False
            self.pairing_attempts = 0
            self.next_pair_at = 0.0
            self.repairs = 0
            paired_path, paired = self.paired_spen()
            if paired_path is not None and paired.get("Connected", False):
                self.refresh_gatt(paired_path, now)
                return True
            if enabled and paired_path is not None:
                self.set_trusted(paired_path)
                self.battery.update(None, None)
                self.connect(paired_path)
                return True
            self.battery.update(None, None)
            return True

        if not self.dock_seen:
            self.dock_seen = True
            self.pairing_attempted = False
            self.pairing_attempts = 0
            self.next_pair_at = 0.0

        paired_path, paired = self.paired_spen()
        if paired_path is not None:
            self.consider(paired_path, paired)
            if self.pairing:
                self.finish_pairing()
            if paired.get("Connected", False):
                self.refresh_gatt(paired_path, now)
            else:
                self.battery.update(None, None)
                if now - self.last_connect_at >= CONNECT_INTERVAL_SECONDS:
                    self.connect(paired_path)
            return True

        if self.pairing and now >= self.pairing_deadline:
            self.finish_pairing()
            if self.pairing_attempts < PAIR_ATTEMPTS:
                self.pairing_attempted = False
                self.next_pair_at = now + 2
            else:
                print("S Pen pairing window expired; reinsert the pen to retry",
                      flush=True)
                self.pairing_attempted = True

        if not self.pairing and not self.pairing_attempted and \
                now >= self.next_pair_at:
            self.begin_pairing()

        if self.pairing:
            for path, properties in self.devices().items():
                if is_spen(properties) and not properties.get("Paired", False):
                    self.connect(path)
                    break

        self.battery.update(None, None)
        return True

    def tick_once(self):
        try:
            return self.tick()
        except dbus.DBusException as error:
            print(f"S Pen pairing tick failed: {error}", flush=True)
            return True


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    while True:
        try:
            service = Service(dbus.SystemBus())
            break
        except (StopIteration, dbus.DBusException) as error:
            print(f"Waiting for the Bluetooth adapter: {error}", flush=True)
            time.sleep(3)

    service.tick_once()
    GLib.timeout_add_seconds(2, service.tick_once)
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
