#!/usr/bin/python3
# Power key for the GNOME session on the Tab S9 (X710), like Android/iPadOS:
#   short press  -> lock screen and immediately blank the OLED panel
#   hold 0.7 s   -> GNOME's power-off dialog (Restart / Power Off)
#   locked + dark for LOCK_IDLE_SUSPEND_S (5 min) -> deep suspend
# Lid close (keyboard cover) stays handled by logind directly for immediate
# suspend.
#
# GNOME's own handling is off (power-button-action='nothing') because it acts
# on key-down, before a long press can be told apart.  The press that wakes
# the tablet reaches us after resume; it is recognised and dropped, so waking
# does not re-blank: time was spent suspended since the last press
# (BOOTTIME - MONOTONIC grew; the kernel updates it before tasks thaw, unlike
# suspend_stats) and the wake IRQ was the power key's.
#
# A press while the screen is off, or within WAKE_GRACE_MS after it came on
# (Mutter's PowerSaveMode), only wakes the screen.
#
# A press that comes while a suspend is on its way (logind's PrepareForSleep
# was sent) or within WAKE_GRACE_MS after the resume is the press that wakes
# the tablet: it is dropped too.  A press while the lock/blank sequence is
# still pending cancels it and keeps the screen on.
import os
import struct
import sys
import time

from gi.repository import Gio, GLib

EVENT = struct.Struct('llHHi')
EV_KEY, KEY_POWER = 1, 116
LONG_MS = 700
LOCK_WAIT_MS = 2000
BLANK_AFTER_LOCK_MS = 250
WAKE_GRACE_MS = 1000
LOCK_IDLE_SUSPEND_S = 300
LOCK_IDLE_RETRY_S = 60
GSM_INHIBITOR_FLAG_SUSPEND = 4


def find_device():
    for name in sorted(os.listdir('/sys/class/input')):
        if not name.startswith('event'):
            continue
        try:
            with open(f'/sys/class/input/{name}/device/name') as f:
                if f.read().strip() == 'pmic_pwrkey':
                    return f'/dev/input/{name}'
        except OSError:
            pass
    return None


def pwrkey_irq():
    with open('/proc/interrupts') as f:
        for line in f:
            if line.rstrip().endswith('pmic_pwrkey'):
                return line.split(':', 1)[0].strip()
    return None


def asleep():
    """Seconds spent suspended since boot."""
    return time.clock_gettime(time.CLOCK_BOOTTIME) - \
        time.clock_gettime(time.CLOCK_MONOTONIC)


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


class PowerKey:
    def __init__(self, dev):
        self.fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
        self.irq = pwrkey_irq()
        self.asleep = asleep()
        self.timer = 0
        self.ignore_release = False
        self.lock_wait = 0
        self.blank_wait = 0
        self.idle_suspend_timer = 0
        self.sleeping = False
        self.resumed = 0.0
        self.screensaver_settings = Gio.Settings.new('org.gnome.desktop.screensaver')
        self.system = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.session = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.screen_locked = False
        self.display_off = False
        self.display_on = 0.0
        self.session.signal_subscribe(
            'org.gnome.ScreenSaver', 'org.gnome.ScreenSaver',
            'ActiveChanged', '/org/gnome/ScreenSaver', None,
            Gio.DBusSignalFlags.NONE, self.on_screensaver_active)
        try:
            self.screen_locked = bool(self.screensaver('GetActive').unpack()[0])
        except GLib.Error:
            pass
        self.session.signal_subscribe(
            'org.gnome.Mutter.DisplayConfig', 'org.freedesktop.DBus.Properties',
            'PropertiesChanged', '/org/gnome/Mutter/DisplayConfig', None,
            Gio.DBusSignalFlags.NONE, self.on_display_props)
        try:
            mode = self.session.call_sync(
                'org.gnome.Mutter.DisplayConfig', '/org/gnome/Mutter/DisplayConfig',
                'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.gnome.Mutter.DisplayConfig', 'PowerSaveMode')),
                None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            self.display_off = mode != 0
        except GLib.Error:
            pass
        self.system.signal_subscribe(
            'org.freedesktop.login1', 'org.freedesktop.login1.Manager',
            'PrepareForSleep', '/org/freedesktop/login1', None,
            Gio.DBusSignalFlags.NONE, self.on_prepare_for_sleep)
        self.sync_idle_suspend()
        GLib.unix_fd_add_full(GLib.PRIORITY_DEFAULT, self.fd,
                              GLib.IOCondition.IN, self.on_input)

    def on_screensaver_active(self, bus, sender, path, iface, signal, args):
        self.screen_locked = bool(args.unpack()[0])
        self.sync_idle_suspend()

    def on_display_props(self, bus, sender, path, iface, signal, args):
        changed = args.unpack()[1]
        if 'PowerSaveMode' not in changed:
            return
        off = changed['PowerSaveMode'] != 0
        if self.display_off and not off:
            self.display_on = time.monotonic()
        self.display_off = off
        self.sync_idle_suspend()

    def on_prepare_for_sleep(self, bus, sender, path, iface, signal, args):
        self.sleeping = args.unpack()[0]
        if not self.sleeping:
            self.resumed = time.monotonic()
            if self.is_display_dark() and not self.lid_closed():
                self.wake_display()
        self.sync_idle_suspend()

    def is_display_dark(self):
        return self.display_off or \
            read('/sys/class/drm/card0-DSI-1/dpms') in ('Off', 'off')

    def lid_closed(self):
        try:
            return bool(self.system.call_sync(
                'org.freedesktop.login1', '/org/freedesktop/login1',
                'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.freedesktop.login1.Manager', 'LidClosed')),
                None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0])
        except GLib.Error:
            return False

    def wake_display(self):
        self.call(
            self.session,
            'org.gnome.Mutter.DisplayConfig',
            '/org/gnome/Mutter/DisplayConfig',
            'org.freedesktop.DBus.Properties', 'Set',
            GLib.Variant('(ssv)', ('org.gnome.Mutter.DisplayConfig',
                                   'PowerSaveMode',
                                   GLib.Variant('i', 0))))

    def cancel_idle_suspend(self):
        if self.idle_suspend_timer:
            GLib.source_remove(self.idle_suspend_timer)
            self.idle_suspend_timer = 0

    def sync_idle_suspend(self):
        if self.screen_locked and self.display_off and not self.sleeping:
            if not self.idle_suspend_timer:
                self.idle_suspend_timer = GLib.timeout_add_seconds(
                    LOCK_IDLE_SUSPEND_S, self.on_idle_suspend)
        else:
            self.cancel_idle_suspend()

    def is_suspend_inhibited(self):
        try:
            inhibited = self.session.call_sync(
                'org.gnome.SessionManager', '/org/gnome/SessionManager',
                'org.gnome.SessionManager', 'IsInhibited',
                GLib.Variant('(u)', (GSM_INHIBITOR_FLAG_SUSPEND,)),
                None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            if inhibited:
                return True
        except GLib.Error:
            pass
        try:
            blocked = self.system.call_sync(
                'org.freedesktop.login1', '/org/freedesktop/login1',
                'org.freedesktop.DBus.Properties', 'Get',
                GLib.Variant('(ss)', ('org.freedesktop.login1.Manager', 'BlockInhibited')),
                None, Gio.DBusCallFlags.NONE, 1000, None).unpack()[0]
            if 'sleep' in str(blocked).split(':'):
                return True
        except GLib.Error:
            pass
        return False

    def on_idle_suspend(self):
        self.idle_suspend_timer = 0
        if not (self.screen_locked and self.display_off and not self.sleeping):
            return False
        if self.charge_hold_eligible():
            self.engage_charge_hold()
            self.idle_suspend_timer = GLib.timeout_add_seconds(
                LOCK_IDLE_RETRY_S, self.on_idle_suspend)
            return False
        if self.is_suspend_inhibited():
            print('locked-idle suspend deferred: inhibited',
                  file=sys.stderr, flush=True)
            self.idle_suspend_timer = GLib.timeout_add_seconds(
                LOCK_IDLE_RETRY_S, self.on_idle_suspend)
            return False
        print('locked-idle timeout reached: entering deep suspend',
              file=sys.stderr, flush=True)
        self.suspend()
        return False

    def woke_by_this_key(self):
        now = time.monotonic()
        if self.sleeping or self.display_off or \
                read('/sys/class/drm/card0-DSI-1/dpms') in ('Off', 'off') or \
                now - self.resumed < WAKE_GRACE_MS / 1000 or \
                now - self.display_on < WAKE_GRACE_MS / 1000:
            return True
        slept = asleep()
        if slept - self.asleep < 0.05:
            return False
        self.asleep = slept
        return self.irq is not None and \
            read('/sys/power/pm_wakeup_irq') == self.irq

    def on_input(self, fd, cond):
        try:
            data = os.read(fd, EVENT.size * 64)
        except BlockingIOError:
            return True
        for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, etype, code, value = EVENT.unpack_from(data, off)
            if etype == EV_KEY and code == KEY_POWER:
                if value == 1:
                    self.pressed()
                elif value == 0:
                    self.released()
        return True

    def pressed(self):
        if self.lock_wait or self.blank_wait:
            # Pressed again before the screen went dark: stay awake.
            print('press during lock: blank cancelled', file=sys.stderr, flush=True)
            if self.lock_wait:
                GLib.source_remove(self.lock_wait)
                self.lock_wait = 0
            if self.blank_wait:
                GLib.source_remove(self.blank_wait)
                self.blank_wait = 0
            self.ignore_release = True
            return
        if self.woke_by_this_key():
            print('wake press dropped', file=sys.stderr, flush=True)
            self.mark_wake()
            if self.is_display_dark():
                self.wake_display()
            self.ignore_release = True
            return
        self.cancel()
        self.timer = GLib.timeout_add(LONG_MS, self.long_press)

    def released(self):
        if self.ignore_release:
            self.ignore_release = False
            return
        if self.timer:
            self.cancel()
            self.lock_then_blank()

    def screensaver(self, method, args=None):
        return self.session.call_sync(
            'org.gnome.ScreenSaver', '/org/gnome/ScreenSaver',
            'org.gnome.ScreenSaver', method, args, None,
            Gio.DBusCallFlags.NONE, 1000, None)

    def schedule_blank(self, delay_ms):
        if self.blank_wait:
            GLib.source_remove(self.blank_wait)
        self.blank_wait = GLib.timeout_add(delay_ms, self.on_blank_timer)

    def on_blank_timer(self):
        self.blank_wait = 0
        self.blank_display()
        return False

    def lock_then_blank(self):
        if self.lock_wait or self.blank_wait:
            return
        if not self.screensaver_settings.get_boolean('lock-enabled'):
            self.blank_display()
            return
        try:
            if self.screensaver('GetActive').unpack()[0]:
                self.blank_display()
                return
            self.screensaver('SetActive', GLib.Variant('(b)', (True,)))
        except GLib.Error as e:
            print(f'lock failed: {e.message}', file=sys.stderr)
            self.blank_display()
            return
        self.lock_waited = 0
        self.lock_wait = GLib.timeout_add(100, self.poll_lock)

    def poll_lock(self):
        self.lock_waited += 100
        try:
            active = self.screensaver('GetActive').unpack()[0]
        except GLib.Error:
            active = False
        if not active and self.lock_waited < LOCK_WAIT_MS:
            return True
        self.lock_wait = 0
        self.schedule_blank(BLANK_AFTER_LOCK_MS)
        return False

    @staticmethod
    def mark_wake():
        try:
            path = os.path.join(GLib.get_user_runtime_dir(),
                                'gts9wifi-power-key-wake')
            with open(path, 'w'):
                pass
        except (OSError, TypeError):
            pass

    def charge_hold_eligible(self):
        if read('/var/lib/gts9wifi/charge-hold') == '0':
            return False
        if read('/sys/class/power_supply/sm5714-usb/online') != '1':
            return False
        try:
            cap = int(read('/sys/class/power_supply/sm5714-battery/capacity') or '100')
        except ValueError:
            return False
        return cap < 90 and os.path.exists('/sys/bus/i2c/devices/4-0063/charge_hold')

    def blank_display(self):
        try:
            self.session.call_sync(
                'org.gnome.Mutter.DisplayConfig',
                '/org/gnome/Mutter/DisplayConfig',
                'org.freedesktop.DBus.Properties', 'Set',
                GLib.Variant('(ssv)', ('org.gnome.Mutter.DisplayConfig',
                                       'PowerSaveMode',
                                       GLib.Variant('i', 1))),
                None, Gio.DBusCallFlags.NONE, 1000, None)
        except GLib.Error as e:
            print(f'PowerSaveMode blank failed: {e.message}', file=sys.stderr)

    def engage_charge_hold(self):
        # Keep PPS direct charging alive with the screen off until 90%.
        for path in ('/sys/bus/i2c/devices/6-0049/fast_charge',
                     '/sys/bus/i2c/devices/4-0063/charge_hold'):
            try:
                with open(path, 'w') as f:
                    f.write('1\n')
            except OSError:
                pass

    def suspend(self):
        if self.charge_hold_eligible():
            self.engage_charge_hold()
            self.blank_display()
            return
        try:
            with open('/sys/bus/i2c/devices/4-0063/charge_hold', 'w') as f:
                f.write('0\n')
        except OSError:
            pass
        self.call(self.system, 'org.freedesktop.login1',
                  '/org/freedesktop/login1',
                  'org.freedesktop.login1.Manager', 'Suspend',
                  GLib.Variant('(b)', (False,)))

    def long_press(self):
        self.timer = 0
        self.call(self.session, 'org.gnome.SessionManager',
                  '/org/gnome/SessionManager', 'org.gnome.SessionManager',
                  'Shutdown', None)
        return False

    def cancel(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0

    @staticmethod
    def call(bus, name, path, iface, method, args):
        bus.call(name, path, iface, method, args, None,
                 Gio.DBusCallFlags.NONE, -1, None,
                 lambda b, res: PowerKey.done(b, res, method))

    @staticmethod
    def done(bus, res, method):
        try:
            bus.call_finish(res)
        except GLib.Error as e:
            print(f'{method} failed: {e.message}', file=sys.stderr)


def main():
    if not os.path.exists('/etc/gts9wifi/power-key-enabled'):
        return 0
    dev = find_device()
    if dev is None:
        print('pmic_pwrkey input device not found', file=sys.stderr)
        return 1
    PowerKey(dev)
    GLib.MainLoop().run()
    return 0


if __name__ == '__main__':
    sys.exit(main())
