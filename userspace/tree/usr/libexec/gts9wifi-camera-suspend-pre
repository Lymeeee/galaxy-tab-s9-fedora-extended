#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Camera safety net, part 1.  systemd-sleep freezes user.slice before the
# /usr/lib/systemd/system-sleep pre hooks run, so an old pre hook calling
# `systemctl --user stop` blocked for ~45 s and delayed every suspend.  This
# runs from a systemd-suspend.service ExecStartPre drop-in instead, while the
# user manager is still reachable.

set -u

user=lyme
state=/run/gts9wifi-camera-suspend

camera_busy() {
	for fd in /proc/[0-9]*/fd/*; do
		target=$(readlink "$fd" 2>/dev/null) || continue
		case "$target" in
		/dev/v4l-subdev*)
			return 0
			;;
		/dev/video*)
			dev=${target#/dev/}
			name=$(cat "/sys/class/video4linux/$dev/name" 2>/dev/null || true)
			case "$name" in
			qcom-iris-*) continue ;;
			esac
			return 0
			;;
		esac
	done
	return 1
}

uid=$(id -u "$user" 2>/dev/null) || exit 0
[ -d "/run/user/$uid" ] || exit 0
camera_busy || exit 0

: > "$state"
if /usr/bin/timeout 10 /usr/bin/runuser -u "$user" -- \
	/usr/bin/env XDG_RUNTIME_DIR="/run/user/$uid" \
	/usr/bin/systemctl --user stop pipewire.socket pipewire-pulse.socket \
		pipewire.service pipewire-pulse.service; then
	/usr/bin/logger -t gts9wifi-camera-suspend \
		"camera was busy; PipeWire stopped for suspend"
else
	/usr/bin/logger -t gts9wifi-camera-suspend \
		"camera was busy; PipeWire stop failed or timed out"
fi

exit 0
