import glob
import hashlib
import os
import re
import shlex
import shutil
import subprocess
import threading

import gi

gi.require_version('Adw', '1')
gi.require_version('Gtk', '4.0')
from gi.repository import Adw, GLib, Gtk

APP_ID = 'io.github.lymeeee.Gts9wifiSettings'
DEVICE_CONTROL = '/usr/libexec/gts9wifi-device-control'
PRIVILEGED = '/usr/libexec/gts9wifi-privileged'
POWER_PROFILE = '/var/lib/gts9wifi/power-profile'
USB_NET_FLAG = '/etc/gts9wifi/usb-net-enabled'
KEYBOARD_FW = '/lib/firmware/keyboard_stm/stm32_gts9family.bin'
KEYBOARD_FW_SIZE = 52132
KEYBOARD_FW_SHA256 = '1b48d88c23523ae205cd960e6d42725268638a15a47d8a5e52854eb01108caa3'
UPDATE = '/usr/bin/gts9wifi-update'
PROTECT = '/usr/libexec/gts9wifi-protect'
IME = '/usr/libexec/gts9wifi-ime'
OFFICE = '/usr/libexec/gts9wifi-office'
POWERKEY = '/usr/libexec/gts9wifi-powerkey-mode'
SPEN_BUTTON = '/usr/libexec/gts9wifi-spen-button'
SPEN_BUTTON_CONF = '/etc/gts9wifi/spen-button'
LOGGING = '/usr/libexec/gts9wifi-logging'
LOGGING_FLAG = '/etc/gts9wifi/logging-off'
SPEN_BUTTON_DEFAULT = 'KEY_PAGEDOWN'
SPEN_BUTTON_PRESETS = [
    ('下一页', 'KEY_PAGEDOWN'),
    ('上一页', 'KEY_PAGEUP'),
    ('播放/暂停', 'KEY_PLAYPAUSE'),
    ('音量 +', 'KEY_VOLUMEUP'),
    ('音量 -', 'KEY_VOLUMEDOWN'),
    ('空格', 'KEY_SPACE'),
    ('回车', 'KEY_ENTER'),
    ('Esc', 'KEY_ESC'),
    ('无操作', 'none'),
    ('自定义…', None),
]
DEFAULT_KERNEL_TAG = 'latest'
POWER_IDS = ['powersave', 'sticky', 'balanced', 'performance']
MIRROR_IDS = ['ustc', 'tuna']
MIRROR_HOSTS = {
    'ustc': 'mirrors.ustc.edu.cn',
    'tuna': 'mirrors.tuna.tsinghua.edu.cn',
}

STATUS_ZH = {
    'Charging': '充电中',
    'Discharging': '放电中',
    'Full': '已充满',
    'Not charging': '未在充电',
    'Unknown': '状态未知',
}


def run(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None


def rpm(name):
    result = run(['rpm', '-q', '--qf', '%{VERSION}-%{RELEASE}', name])
    if result is not None and result.returncode == 0:
        return result.stdout.strip()
    return '未安装'


def read(path):
    try:
        with open(path, encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        return None


def keyboard_status():
    for diag in glob.glob('/sys/bus/i2c/devices/*-002a/diagnostics'):
        text = read(diag)
        if not text:
            continue
        values = {}
        for item in text.split():
            if '=' in item:
                key, value = item.split('=', 1)
                values[key] = value
        return values
    return {}


class Settings(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.connect('activate', self.activate)
        self._status_rows = {}

    def activate(self, app):
        window = Adw.PreferencesWindow(application=app, title='平板杂项设置')
        window.set_default_size(540, 820)
        self.window = window
        window.add(self.device_page())
        window.add(self.spen_page())
        window.add(self.power_page())
        window.add(self.debug_page())
        window.add(self.setup_page())
        window.add(self.advanced_page())
        window.add(self.status_page())
        window.present()

    def device_page(self):
        page = Adw.PreferencesPage(title='设备', icon_name='preferences-system-symbolic')
        controls = self.controls()
        if not controls:
            group = Adw.PreferencesGroup()
            group.add(Adw.ActionRow(
                title='没有设备控制项',
                subtitle='未找到 gts9wifi-device-control。'))
            page.add(group)
            return page
        groups = {}
        for control in controls:
            if control['group'] not in groups:
                group = Adw.PreferencesGroup(title=control['group'])
                groups[control['group']] = group
                page.add(group)
            row = Adw.SwitchRow(
                title=control['label'],
                subtitle=control['description'],
                active=control['active'])
            guard = {'busy': False}

            def toggled(row, _pspec, control=control, guard=guard):
                if guard['busy']:
                    return
                value = '1' if row.get_active() else '0'
                guard['busy'] = True
                row.set_sensitive(False)

                def worker():
                    result = run([DEVICE_CONTROL, 'set', control['name'], value])
                    GLib.idle_add(finish, result)

                def finish(result):
                    guard['busy'] = False
                    row.set_sensitive(True)
                    if result is None or result.returncode != 0:
                        guard['busy'] = True
                        row.set_active(not row.get_active())
                        guard['busy'] = False
                    return False

                threading.Thread(target=worker, daemon=True).start()

            row.connect('notify::active', toggled)
            groups[control['group']].add(row)
        return page

    def spen_page(self):
        page = Adw.PreferencesPage(title='S Pen', icon_name='input-tablet-symbolic')
        group = Adw.PreferencesGroup(
            title='远端按键',
            description='S Pen 离开数位板感应区时，笔身按键会发送下面的快捷键；'
                        '笔尖靠近屏幕时按键仍由数位板原生处理，不会重复触发。')
        values = [value for _label, value in SPEN_BUTTON_PRESETS]
        labels = Gtk.StringList.new(
            [label for label, _value in SPEN_BUTTON_PRESETS])
        current = read(SPEN_BUTTON_CONF) or SPEN_BUTTON_DEFAULT
        custom_index = len(values) - 1
        if current in values:
            selected = values.index(current)
        else:
            selected = custom_index
        row = Adw.ComboRow(title='按键映射', model=labels, selected=selected)
        custom = Adw.EntryRow(title='按键组合（例如 KEY_LEFTCTRL+KEY_S）')
        custom.set_text(current if selected == custom_index else '')
        custom.set_show_apply_button(True)
        custom.set_visible(selected == custom_index)
        group.add(row)
        group.add(custom)
        page.add(group)

        guard = {'busy': False}
        state = {'index': selected}

        def store(value, revert=None):
            if guard['busy']:
                return
            guard['busy'] = True
            row.set_sensitive(False)
            custom.set_sensitive(False)

            def worker():
                result = run(['pkexec', SPEN_BUTTON, 'set', value], timeout=60)
                GLib.idle_add(finish, result)

            def finish(result):
                guard['busy'] = False
                row.set_sensitive(True)
                custom.set_sensitive(True)
                if result is None or result.returncode != 0:
                    if revert is not None:
                        guard['busy'] = True
                        row.set_selected(revert)
                        guard['busy'] = False
                    self.alert('无法保存 S Pen 按键映射',
                               '请确认 S Pen 服务已安装并完成授权。')
                else:
                    state['index'] = row.get_selected()
                    if row.get_selected() != custom_index:
                        custom.set_text('')
                return False

            threading.Thread(target=worker, daemon=True).start()

        def changed(row, _pspec):
            if guard['busy']:
                return
            value = values[row.get_selected()]
            if value is None:
                custom.set_visible(True)
                custom.grab_focus()
                return
            custom.set_visible(False)
            store(value, revert=state['index'])

        def applied(entry):
            value = entry.get_text().strip()
            if value:
                store(value)

        row.connect('notify::selected', changed)
        custom.connect('apply', applied)
        return page

    def controls(self):
        result = run([DEVICE_CONTROL, 'list'])
        if result is None or result.returncode != 0:
            return []
        controls = []
        for line in result.stdout.splitlines():
            parts = line.split('\t')
            if len(parts) != 5:
                continue
            name, group, label, description, value = parts
            controls.append({
                'name': name, 'group': group, 'label': label,
                'description': description, 'active': value == '1',
            })
        return controls

    def power_page(self):
        page = Adw.PreferencesPage(title='电源', icon_name='battery-symbolic')
        group = Adw.PreferencesGroup(
            title='性能模式',
            description='CPU与GPU性能选项'
                        '修改时需要root密码')
        labels = Gtk.StringList.new(
            ['省电', '敏感', '均衡', '性能'])
        current = read(POWER_PROFILE) or 'balanced'
        if current not in POWER_IDS:
            current = 'balanced'
        row = Adw.ComboRow(
            title='性能模式', model=labels,
            selected=POWER_IDS.index(current))
        guard = {'busy': False}

        def changed(row, _pspec, guard=guard):
            if guard['busy']:
                return
            profile = POWER_IDS[row.get_selected()]
            result = run(['pkexec', PRIVILEGED, 'power', profile], timeout=60)
            if result is None or result.returncode != 0:
                saved = read(POWER_PROFILE) or 'balanced'
                if saved not in POWER_IDS:
                    saved = 'balanced'
                guard['busy'] = True
                row.set_selected(POWER_IDS.index(saved))
                guard['busy'] = False

        row.connect('notify::selected', changed)
        group.add(row)
        page.add(group)
        self.add_battery_group(page)
        return page

    def add_battery_group(self, page):
        battery = Adw.PreferencesGroup(
            title='电池',
            description='SM5714电量计的实时数据')
        self._battery_rows = {}
        for key, title in (
                ('status', '状态'),
                ('power', '充电功率'),
                ('voltage', '电压'),
                ('current', '电流'),
                ('temp', '温度'),
                ('capacity', '电量'),
                ('input', '充电器')):
            battery_row = Adw.ActionRow(title=title, subtitle='…')
            battery.add(battery_row)
            self._battery_rows[key] = battery_row
        page.add(battery)
        self.update_battery()
        GLib.timeout_add(1000, self.update_battery)

    def update_battery(self):
        rows = getattr(self, '_battery_rows', None)
        if not rows:
            return False
        bat = '/sys/class/power_supply/sm5714-battery'
        usb = '/sys/class/power_supply/sm5714-usb'
        voltage = current = power = temp = None
        try:
            voltage_raw = read(bat + '/voltage_now')
            current_raw = read(bat + '/current_now')
            temp_raw = read(bat + '/temp')
            if voltage_raw:
                voltage = float(voltage_raw) / 1e6
            if current_raw:
                current = float(current_raw) / 1e6
            if voltage is not None and current is not None:
                power = voltage * current
            if temp_raw:
                temp = float(temp_raw) / 10
        except ValueError:
            pass
        capacity = read(bat + '/capacity')
        status = read(bat + '/status')
        rows['status'].set_subtitle(STATUS_ZH.get(status, status) or '—')
        rows['capacity'].set_subtitle(f'{capacity} %' if capacity else '—')
        rows['voltage'].set_subtitle(
            f'{voltage:.3f} V' if voltage is not None else '—')
        rows['current'].set_subtitle(
            f'{current:+.3f} A' if current is not None else '—')
        rows['power'].set_subtitle(
            f'{power:+.2f} W' if power is not None else '—')
        rows['temp'].set_subtitle(
            f'{temp:.1f} °C' if temp is not None else '—')
        online = read(usb + '/online')
        voltage_max = read(usb + '/voltage_max')
        current_max = read(usb + '/current_max')
        if online == '1' and voltage_max and current_max:
            try:
                rows['input'].set_subtitle('%0.1f V / %0.2f A 握手协议' % (
                    float(voltage_max) / 1e6, float(current_max) / 1e6))
            except ValueError:
                rows['input'].set_subtitle('已连接')
        else:
            rows['input'].set_subtitle('未连接')
        return True

    def debug_page(self):
        page = Adw.PreferencesPage(title='调试', icon_name='utilities-terminal-symbolic')
        group = Adw.PreferencesGroup(
            title='USB调试网络',
            description='USB与电脑连接后，可使用SSH连接172.16.42.1'
                        '日常使用建议关闭')
        row = Adw.SwitchRow(
            title='启用USB调试网络',
            active=os.path.exists(USB_NET_FLAG))
        guard = {'busy': False}

        def changed(row, _pspec, guard=guard):
            if guard['busy']:
                return
            value = 'on' if row.get_active() else 'off'
            result = run(['pkexec', PRIVILEGED, 'usbnet', value], timeout=60)
            if result is None or result.returncode != 0:
                guard['busy'] = True
                row.set_active(os.path.exists(USB_NET_FLAG))
                guard['busy'] = False

        row.connect('notify::active', changed)
        group.add(row)
        page.add(group)

        logs = Adw.PreferencesGroup(
            title='日志',
            description='关闭 journald 存储、rsyslog/auditd/ABRT 等日志服务，'
                        '并清空 journal、/var/log、崩溃转储和内核缓冲区。'
                        '内核环形缓冲区无法停写，只能在开关时和每次启动时清空；'
                        '关闭后睡眠、崩溃等问题将无法再诊断，重新打开也不会'
                        '恢复已删除的日志。')
        logrow = Adw.SwitchRow(
            title='关闭所有日志',
            active=os.path.exists(LOGGING_FLAG))
        logguard = {'busy': False}

        def apply_logging(row, action):
            logguard['busy'] = True
            row.set_sensitive(False)

            def worker():
                result = run(['pkexec', LOGGING, action], timeout=120)
                GLib.idle_add(finish, result)

            def finish(result):
                logguard['busy'] = False
                row.set_sensitive(True)
                if result is None or result.returncode != 0:
                    self.alert('无法切换日志',
                               '需要 root 授权，日志服务可能正忙。')
                logguard['busy'] = True
                row.set_active(os.path.exists(LOGGING_FLAG))
                logguard['busy'] = False
                return False

            threading.Thread(target=worker, daemon=True).start()

        def log_changed(row, _pspec):
            if logguard['busy']:
                return
            if not row.get_active():
                apply_logging(row, 'on')
                return
            dialog = Adw.AlertDialog(
                heading='关闭日志并清空现有记录？',
                body='将停止所有持久化日志并删除现有日志、崩溃转储和'
                     '内核缓冲区。此操作不可撤销，之后也无法诊断睡眠或'
                     '崩溃问题。')
            dialog.add_response('cancel', '取消')
            dialog.add_response('confirm', '关闭并清空')
            dialog.set_response_appearance(
                'confirm', Adw.ResponseAppearance.DESTRUCTIVE)

            def answered(_dialog, response):
                if response == 'confirm':
                    apply_logging(row, 'off')
                else:
                    logguard['busy'] = True
                    row.set_active(False)
                    logguard['busy'] = False

            dialog.connect('response', answered)
            dialog.present(self.window)

        logrow.connect('notify::active', log_changed)
        logs.add(logrow)
        page.add(logs)
        return page

    def setup_page(self):
        page = Adw.PreferencesPage(title='配置', icon_name='applications-system-symbolic')

        applications = Adw.PreferencesGroup(title='应用')
        installed = shutil.which('easyeffects') is not None
        self.action_row(applications, 'EasyEffects',
            '一个很好用的PipeWire均衡器',
            '打开' if installed else '安装并打开',
            self.open_easyeffects)
        self.action_row(applications, 'ONLYOFFICE 办公套件',
            '卸载 LibreOffice（RPM 或 Flatpak，如存在），下载并安装 '
            'ONLYOFFICE 官方 aarch64 RPM（约 270 MB）。',
            '安装', self.install_onlyoffice)
        page.add(applications)

        repositories = Adw.PreferencesGroup(
            title='软件仓库',
            description='COPR不走镜像，网络不好建议科学上网'
        )
        self.action_row(repositories, 'RPM Fusion',
            'free与nonfree', '启用',
            self.enable_rpmfusion)
        self.copr_entry = Adw.EntryRow(title='COPR项目（owner/project）')
        repositories.add(self.copr_entry)
        self.action_row(repositories, 'COPR仓库',
            '如有需要会自动安装dnf5-plugins，无需操心',
            '安装', self.enable_copr)
        page.add(repositories)

        protection = Adw.PreferencesGroup(title='保护')
        self.protect_row = Adw.SwitchRow(
            title='保护不可升级的包',
            subtitle='固定系统版本，内核以及魔改过的驱动包'
                     '保证你安心运行系统更新也不会重启就崩',
            active=self.protect_enabled())
        guard = {'busy': False}

        def protect_toggled(row, _pspec, guard=guard):
            if guard['busy']:
                return
            action = 'on' if row.get_active() else 'off'
            result = run(['pkexec', PROTECT, action], timeout=30)
            if result is None or result.returncode != 0:
                guard['busy'] = True
                row.set_active(self.protect_enabled())
                guard['busy'] = False

        self.protect_row.connect('notify::active', protect_toggled)
        protection.add(self.protect_row)
        page.add(protection)

        powerkey = Adw.PreferencesGroup(title='电源键')
        self.powerkey_row = Adw.SwitchRow(
            title='更好的电源键',
            subtitle='短按锁定并休眠，长按打开电源菜单'
                     '设定CHASSIS=convertible，需要注销重新登录后生效',
            active=os.path.exists('/etc/gts9wifi/power-key-enabled'))
        self.powerkey_row.connect('notify::active', self.powerkey_toggled)
        powerkey.add(self.powerkey_row)
        page.add(powerkey)

        locale = Adw.PreferencesGroup(title='语言')
        self.action_row(locale, '简体中文',
            '安装zh_CN语言包，设置系统语言和 GNOME 区域'
            '（之后需要注销再登录）。', '设为简体中文', self.enable_chinese)
        self.action_row(locale, '中文输入法（ibus-rime+万象拼音）',
            ' Base；不安装语法模型，关闭行内预编辑并设为默认输入源。',
            '安装', self.install_rime)
        page.add(locale)

        mirrors = Adw.PreferencesGroup(
            title='镜像源',
            description='建议使用USTC，rpmfusion更全'
        )
        self.mirror_row = Adw.ComboRow(
            title='镜像',
            model=Gtk.StringList.new(['USTC', 'TUNA']),
            selected=0)
        mirrors.add(self.mirror_row)
        self.action_row(mirrors, '切换软件源镜像',
            '应用所选镜像并清理缓存', '应用', self.apply_mirrors)
        self.action_row(mirrors, '恢复原先镜像源',
            '恢复首次切换前的仓库备份', '恢复', self.restore_mirrors)
        page.add(mirrors)
        return page

    def mirror_host(self):
        return MIRROR_HOSTS[MIRROR_IDS[self.mirror_row.get_selected()]]

    def protect_enabled(self):
        try:
            with open('/etc/dnf/dnf.conf', encoding='utf-8') as f:
                conf = f.read()
        except OSError:
            return False
        return '# BEGIN gts9wifi-protect' in conf and os.path.exists('/etc/dnf/vars/releasever')

    def powerkey_toggled(self, row, _pspec):
        if getattr(self, '_powerkey_busy', False):
            return
        enable = row.get_active()
        ok = True
        if enable:
            result = run(['pkexec', POWERKEY, 'on'], timeout=30)
            ok = result is not None and result.returncode == 0
            if ok:
                run(['systemctl', '--user', 'daemon-reload'], timeout=20)
                result = run(['systemctl', '--user', 'enable', '--now',
                              'gts9wifi-power-key.service'], timeout=30)
                ok = result is not None and result.returncode == 0
            if ok:
                run(['gsettings', 'set', 'org.gnome.settings-daemon.plugins.power',
                     'power-button-action', 'nothing'], timeout=10)
                run(['systemctl', '--user', 'restart',
                     'org.gnome.SettingsDaemon.MediaKeys.service'], timeout=20)
                self.alert('请注销后重新登录',
                    '电源键才会按预期工作。')
        else:
            run(['systemctl', '--user', 'disable', '--now',
                 'gts9wifi-power-key.service'], timeout=30)
            run(['gsettings', 'set', 'org.gnome.settings-daemon.plugins.power',
                 'power-button-action', 'suspend'], timeout=10)
            result = run(['pkexec', POWERKEY, 'off'], timeout=30)
            ok = result is not None and result.returncode == 0
            run(['systemctl', '--user', 'restart',
                 'org.gnome.SettingsDaemon.MediaKeys.service'], timeout=20)
        if not ok:
            self._powerkey_busy = True
            row.set_active(os.path.exists('/etc/gts9wifi/power-key-enabled'))
            self._powerkey_busy = False
            self.alert('电源键模式设置失败',
                '无法切换模式；请检查 polkit 提示或用户服务。')

    def open_easyeffects(self):
        if shutil.which('easyeffects'):
            try:
                subprocess.Popen(['easyeffects'])
            except OSError as error:
                self.alert('无法启动EasyEffects', str(error))
            return
        self.confirm_simple(
            '安装 EasyEffects？',
            '安装 Fedora 的 EasyEffects 软件包后打开。',
            lambda: self.open_terminal([
                'bash', '-lc',
                'pkexec dnf install -y easyeffects && easyeffects']))

    def enable_rpmfusion(self):
        if rpm('rpmfusion-free-release') != 'not installed':
            self.alert('RPM Fusion已启用', '发行版软件包已安装。')
            return
        host = self.mirror_host()
        command = (
            'pkexec dnf install -y '
            f'https://{host}/rpmfusion/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm '
            f'https://{host}/rpmfusion/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm')
        self.confirm_simple(
            '启用 RPM Fusion？',
            '从 %s 安装 RPM Fusion 发行版软件包。' % host,
            lambda: self.open_terminal(['bash', '-lc', command]))

    def enable_copr(self):
        project = self.copr_entry.get_text().strip()
        if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', project):
            self.alert('COPR项目无效', '请使用 owner/project 的形式。')
            return
        command = ('pkexec dnf install -y dnf5-plugins && '
                   'pkexec dnf copr enable -y ' + shlex.quote(project))
        self.confirm_simple(
            '启用COPR仓库？',
            '安装 %s。' % project,
            lambda: self.open_terminal(['bash', '-lc', command]))

    def enable_chinese(self):
        command = (
            'pkexec dnf install -y langpacks-zh_CN glibc-langpack-zh && '
            'pkexec localectl set-locale LANG=zh_CN.UTF-8 && '
            'pkexec /usr/bin/gdbus call --system --dest org.freedesktop.Accounts '
            '--object-path /org/freedesktop/Accounts/User$(id -u) '
            "--method org.freedesktop.Accounts.User.SetLanguage 'zh_CN.UTF-8' && "
            "gsettings set org.gnome.system.locale region 'zh_CN.UTF-8'")
        self.confirm_simple(
            '切换到简体中文？',
            '安装语言包，设置系统和用户语言'
            '以及 GNOME 区域。注销并重新登录后'
            '界面语言生效；部分移植工具仍为英文。',
            lambda: self.open_terminal(['bash', '-lc', command]))

    def install_onlyoffice(self):
        self.confirm_simple(
            '安装ONLYOFFICE？',
            '将卸载LibreOffice，然后从ONLYOFFICE'
            ' 官方源下载aarch64版RPM包并安装',
            lambda: self.open_terminal([OFFICE]))

    def install_rime(self):
        self.confirm_simple(
            '安装中文输入法？',
            '卸载ibus-libpinyin，安装ibus-rime与万象拼音，'
            '删除语法模型、关闭行内预编辑，并把 Rime 设为默认输入源。'
            '会先备份现有 Rime 配置。',
            lambda: self.open_terminal([IME]))

    def apply_mirrors(self):
        mirror = MIRROR_IDS[self.mirror_row.get_selected()]
        self.confirm_simple(
            '切换软件源镜像？',
            '会保留备份；可用“恢复”还原。',
            lambda: self.open_terminal(['pkexec', '/usr/libexec/gts9wifi-mirrors', mirror]))

    def restore_mirrors(self):
        self.confirm_simple(
            '恢复仓库文件？',
            '恢复首次切换镜像前的仓库备份。',
            lambda: self.open_terminal(['pkexec', '/usr/libexec/gts9wifi-mirrors', '--restore']))

    def advanced_page(self):
        page = Adw.PreferencesPage(title='高级', icon_name='dialog-warning-symbolic')

        components = Adw.PreferencesGroup(
            title='组件',
            description='将要打开带终端；更新工具会自行校验下载内容。')
        self.action_row(components, '用户态软件包',
            '安装最新的用户态控制项和更新。',
            '安装', lambda: self.confirm_simple(
                '更新用户态软件包？',
                '从Github Releases安装用户态软件包',
                lambda: self.open_terminal(['pkexec', UPDATE, 'userspace'])))
        self.action_row(components, 'FFmpeg编解码器',
            '安装为硬解而改造的ffmpeg。',
            '安装', lambda: self.confirm_simple(
                '安装FFmpeg编解码器？',
                '下载并校验ffmpeg-free运行时 RPM。',
                lambda: self.open_terminal(['pkexec', UPDATE, 'ffmpeg'])))
        self.action_row(components, '指纹组件',
            '安装EL721和TEE驱动。',
            '安装', lambda: self.confirm_simple(
                '安装指纹组件？',
                '安装 libfprint EL721 和指纹运行时，并从本机 sec_efs '
                '只读导入校准（calib.dat/egoptbds.dat）。装完重启即可录入。',
                lambda: self.open_terminal(
                    ['pkexec', UPDATE, 'fingerprint', '--calib-from-device'])))
        page.add(components)

        kernel = Adw.PreferencesGroup(
            title='内核与启动',
            description='只有在下方的输入确认后才会写入 boot 分区。')
        self.kernel_tag = Adw.EntryRow(title='内核 release 标签')
        self.kernel_tag.set_text(DEFAULT_KERNEL_TAG)
        kernel.add(self.kernel_tag)
        self.action_row(kernel, '更新内核+启动包',
            '下载并校验，备份并写入新的四大分区，然后安装内核RPM。',
            '刷写', self.flash_kernel, destructive=True)
        self.action_row(kernel, '回滚',
            '恢复最近一次系统分区及内核备份。',
            '回滚', self.rollback_boot, destructive=True)
        page.add(kernel)

        keyboard = Adw.PreferencesGroup(
            title='键盘',
            description='这里负责安装键盘固件；如果固件不是V37，键盘可能会无法使用。')
        self.keyboard_row = Adw.ActionRow(
            title='STM32 V37固件',
            subtitle=self.keyboard_subtitle())
        install = Gtk.Button(label='安装')
        install.connect('clicked', lambda _button: self.choose_keyboard_firmware())
        self.keyboard_row.add_suffix(install)
        keyboard.add(self.keyboard_row)
        page.add(keyboard)
        return page

    def action_row(self, group, title, subtitle, button_label, callback, destructive=False):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        button = Gtk.Button(label=button_label)
        if destructive:
            button.add_css_class('destructive-action')
        button.connect('clicked', lambda _button: callback())
        row.add_suffix(button)
        group.add(row)
        return row

    def keyboard_subtitle(self):
        keyboard = keyboard_status()
        if keyboard.get('flash_version'):
            return 'flash_version=%s app_version=%s' % (
                keyboard.get('flash_version'), keyboard.get('app_version', '?'))
        return '未检测到控制器'

    def alert(self, heading, body):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response('close', '关闭')
        dialog.set_default_response('close')
        dialog.present(self.window)

    def confirm_simple(self, heading, body, callback):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        dialog.add_response('cancel', '取消')
        dialog.add_response('ok', '继续')
        dialog.set_response_appearance('ok', Adw.ResponseAppearance.SUGGESTED)

        def response(_dialog, answer):
            if answer == 'ok':
                callback()

        dialog.connect('response', response)
        dialog.present(self.window)

    def confirm_typed(self, heading, body, word, callback):
        dialog = Adw.AlertDialog(heading=heading, body=body)
        entry = Gtk.Entry(placeholder_text='输入 %s 以确认' % word)
        dialog.set_extra_child(entry)
        dialog.add_response('cancel', '取消')
        dialog.add_response('ok', '继续')
        dialog.set_response_appearance('ok', Adw.ResponseAppearance.DESTRUCTIVE)

        def response(_dialog, answer):
            if answer == 'ok' and entry.get_text().strip() == word:
                callback()

        dialog.connect('response', response)
        dialog.present(self.window)

    def flash_kernel(self):
        tag = self.kernel_tag.get_text().strip()
        if not tag or any(c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-' for c in tag):
            self.alert('标签无效', '请使用 latest 或形如 kernel-7.2.0-20261109.67 的日期标签。')
            return
        self.confirm_typed(
            '刷写内核和系统分区？',
            '这会写入boot、init_boot、vendor_boot和dtbo，然后安装匹配的内核RPM。'
            '工具会校验下载并保留备份。标签：%s' % tag,
            'FLASH',
            lambda: self.open_terminal(['pkexec', UPDATE, 'kernel', '--tag', tag, '--flash']))

    def rollback_boot(self):
        self.confirm_typed(
            '回滚分区？',
            '恢复最近的分区备份和内核模块，然后重启。',
            'ROLLBACK',
            lambda: self.open_terminal(['pkexec', UPDATE, 'rollback']))

    def choose_keyboard_firmware(self):
        dialog = Gtk.FileDialog(title='选择 stm32_gts9family.bin')
        dialog.open(self.window, None, self.keyboard_file_chosen)

    def keyboard_file_chosen(self, dialog, result):
        try:
            file = dialog.open_finish(result)
            path = file.get_path()
        except Exception:
            return
        if not path:
            return
        try:
            data = open(path, 'rb').read()
        except OSError as error:
            self.alert('无法读取文件', str(error))
            return
        if len(data) != KEYBOARD_FW_SIZE or hashlib.sha256(data).hexdigest() != KEYBOARD_FW_SHA256:
            self.alert('固件不正确',
                '需要 52132 字节、SHA-256 为 %s 的 V37 stm32_gts9family.bin。' % KEYBOARD_FW_SHA256)
            return
        self.confirm_typed(
            '安装键盘 V37 固件？',
            '文件会复制到 /lib/firmware/keyboard_stm/。系统会在下次启动时'
            '写入MCU（如果尚未是V37）；该写入是永久的！！！',
            'MCU',
            lambda: self.open_terminal([
                'pkexec', '/usr/bin/install', '-D', '-m0644', path, KEYBOARD_FW]))

    def open_terminal(self, argv):
        command = ' '.join(shlex.quote(arg) for arg in argv)
        script = '%s; rc=$?; echo; read -r -p "按回车关闭…" _; exit $rc' % command
        candidates = [
            ('ptyxis', ['--']),
            ('kgx', ['--']),
            ('gnome-terminal', ['--']),
            ('xterm', ['-e']),
        ]
        for term, args in candidates:
            if shutil.which(term):
                subprocess.Popen([term, *args, 'bash', '-lc', script])
                return
        self.alert('未找到终端', '请手动运行以下命令：\n' + command)

    def status_page(self):
        page = Adw.PreferencesPage(title='状态', icon_name='dialog-information-symbolic')
        group = Adw.PreferencesGroup(title='系统')
        refresh = Gtk.Button.new_from_icon_name('view-refresh-symbolic')
        refresh.set_tooltip_text('刷新')
        refresh.connect('clicked', lambda _button: self.update_status())
        header = Adw.ActionRow(title='设备与固件状态')
        header.add_suffix(refresh)
        group.add(header)
        for key, title in [
            ('kernel', '内核版本'),
            ('userspace', '用户态软件版本'),
            ('libfprint', '指纹驱动'),
            ('fingerprint', '指纹'),
            ('esfp', '指纹设备'),
            ('keyboard', '键盘控制器'),
            ('keyboard_fw', '键盘固件'),
            ('ffmpeg', 'FFmpeg编解码器'),
            ('vendor', '/vendor分区'),
            ('usbnet', 'USB 调试网络'),
        ]:
            row = Adw.ActionRow(title=title, subtitle='…')
            group.add(row)
            self._status_rows[key] = row
        page.add(group)
        self.update_status()
        return page

    def update_status(self):
        rows = self._status_rows
        rows['kernel'].set_subtitle(os.uname().release)
        rows['userspace'].set_subtitle(rpm('gts9wifi-userspace'))
        rows['libfprint'].set_subtitle(rpm('libfprint'))
        rows['fingerprint'].set_subtitle(rpm('gts9wifi-fingerprint'))
        rows['esfp'].set_subtitle(
            '/dev/esfp0 存在' if os.path.exists('/dev/esfp0') else '未检测到')
        keyboard = keyboard_status()
        if keyboard.get('flash_version'):
            rows['keyboard'].set_subtitle(
                'flash_version=%s app_version=%s' % (
                    keyboard.get('flash_version'), keyboard.get('app_version', '?')))
        else:
            rows['keyboard'].set_subtitle('未检测到控制器')
        rows['keyboard_fw'].set_subtitle(
            '已安装' if os.path.exists(KEYBOARD_FW) else '未安装（V37 固件）')
        rows['ffmpeg'].set_subtitle(rpm('libavcodec-free'))
        rows['vendor'].set_subtitle(
            '已只读挂载' if os.path.ismount('/vendor') else '未挂载')
        rows['usbnet'].set_subtitle(
            '已启用（标志文件存在）' if os.path.exists(USB_NET_FLAG) else '已禁用（默认）')


def main():
    return Settings().run([])


if __name__ == '__main__':
    raise SystemExit(main())
