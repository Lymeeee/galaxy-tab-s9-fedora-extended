#!/bin/bash
# gts9wifi-update: userspace and boot-partition updates for the nacht Fedora port.
#
# Userspace updates are ordinary RPM installs.  Kernel updates are a paired
# kernel RPM + Android boot bundle; flashing boot partitions is irreversible
# and therefore requires --flash explicitly.  This tool never writes vbmeta,
# persist, modemst or efs.
set -euo pipefail

REPO=${GTS9WIFI_REPO:-Lymeeee/galaxy-tab-s9-fedora-extended}
DEFAULT_TAG=${GTS9WIFI_TAG:-latest}
DEFAULT_FFMPEG_TAG=${GTS9WIFI_FFMPEG_TAG:-ffmpeg-8.1.3-gts9wifi-1}
DEFAULT_LIBFPRINT_TAG=${GTS9WIFI_LIBFPRINT_TAG:-libfprint-1.94.100-gts9wifi-2}
DEFAULT_FINGERPRINT_TAG=${GTS9WIFI_FINGERPRINT_TAG:-gts9wifi-fingerprint-0.1.5-1}
STATE=${GTS9WIFI_STATE:-/var/lib/gts9wifi}
LOCKDIR=/usr/share/gts9wifi/versionlock.d
BOOT_PARTS=(boot init_boot vendor_boot dtbo)
part_size() {
    case "$1" in
        boot|vendor_boot) echo 100663296 ;;
        init_boot) echo 8388608 ;;
        dtbo) echo 16777216 ;;
        *) return 1 ;;
    esac
}

cmd=${1:-check}
[ $# -gt 0 ] && shift || true
tag=${GTS9WIFI_TAG:-}
libfprint_tag=""
fingerprint_tag=""
calib_dir=""
calib_from_device=0
dry=0
flash=0
reboot_after=0
backup_arg=""

usage() {
    cat <<'EOF'
Usage: gts9wifi-update <command> [options]

Commands:
  check                 show installed versions, release assets and boot state
  check-all             compare every installed component with its release
  all                   update userspace, dynpart, libcamera, fingerprint and ffmpeg
  userspace             install the userspace RPM from the release
  wifi                  reapply the WCN6855 board data (5 GHz RX fix)
  ffmpeg                install the rebuilt ffmpeg-free (v4l2m2m) RPMs
  libcamera             install the patched libcamera (HI1337 AWB/autofocus)
  fingerprint           install libfprint EL721 + the secure-start runtime
  calib [--calib-from-device|--calib DIR]
                        import the fingerprint calibration only
  kernel [--flash]      download/verify the kernel pair; write boot partitions with --flash
  rollback [--backup D] restore the latest (or D) boot-partition backup

The kernel is never flashed by "all"; use the kernel command with --flash.

Options:
  --tag TAG             release tag (default: latest,
                        ffmpeg-8.1.3-gts9wifi-1 for ffmpeg)
  --libfprint-tag TAG   libfprint EL721 release (default: libfprint-1.94.100-gts9wifi-2)
  --fingerprint-tag TAG runtime release (default: gts9wifi-fingerprint-0.1.5-1)
  --calib DIR           copy calib.dat/egoptbds.dat from DIR into the firmware store
  --calib-from-device   import this unit's calibration from sec_efs (ro)
  --dry-run             print the plan without installing or writing
  --flash               allow kernel boot-partition writes (kernel command only)
  --reboot              reboot after a successful kernel update/rollback
  --backup DIR          backup directory for rollback
EOF
}

die() { echo "gts9wifi-update: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "run as root"; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }

while [ $# -gt 0 ]; do
    case "$1" in
        --tag) tag=${2:?missing value}; shift 2 ;;
        --libfprint-tag) libfprint_tag=${2:?missing value}; shift 2 ;;
        --fingerprint-tag) fingerprint_tag=${2:?missing value}; shift 2 ;;
        --calib) calib_dir=${2:?missing value}; shift 2 ;;
        --calib-from-device) calib_from_device=1; shift ;;
        --dry-run) dry=1; shift ;;
        --flash) flash=1; shift ;;
        --reboot) reboot_after=1; shift ;;
        --backup) backup_arg=${2:?missing value}; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

api_json() {
    local t=${1:-$tag}
    # check-all runs unprivileged from Settings; fall back to the user cache.
    mkdir -p "$STATE" 2>/dev/null || true
    [ -w "$STATE" ] ||
        STATE=${XDG_CACHE_HOME:-$HOME/.cache}/gts9wifi
    mkdir -p "$STATE"
    local f="$STATE/release-$t.json"
    if [ ! -s "$f" ] || [ "${GTS9WIFI_REFRESH:-0}" = 1 ] ||
        [ -n "$(find "$f" -mmin +5 2>/dev/null)" ]; then
        curl -fsSL --retry 3 --retry-delay 2 \
            "https://api.github.com/repos/$REPO/releases/tags/$t" -o "$f.part" &&
            mv "$f.part" "$f"
    fi
    printf '%s\n' "$f"
}

# asset_for <tag> <regex> -> "name<TAB>url" for the first matching asset
asset_for() {
    local t=$1 pat=$2 json line
    json=$(api_json "$t") || return 1
    line=$(python3 - "$json" "$pat" <<'PY'
import json, re, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
pat = re.compile(sys.argv[2])
matches = []
for item in data.get("assets", []):
    name = item.get("name", "")
    if pat.search(name):
        matches.append((name, item.get("browser_download_url", "")))
if matches:
    def version_key(name):
        return [int(part) if part.isdigit() else part
                for part in re.split(r"(\d+)", name)]
    matches.sort(key=lambda item: version_key(item[0]), reverse=True)
    print(matches[0][0] + "\t" + matches[0][1])
PY
) || return 1
    [ -n "$line" ] || return 1
    printf '%s\n' "$line"
}

# asset <regex> -> "name<TAB>url" for the first matching release asset
asset() {
    local json line
    json=$(api_json) || return 1
    line=$(python3 - "$json" "$1" <<'PY'
import json, re, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
pat = re.compile(sys.argv[2])
matches = []
for item in data.get("assets", []):
    name = item.get("name", "")
    if pat.search(name):
        matches.append((name, item.get("browser_download_url", "")))
if matches:
    def version_key(name):
        return [int(part) if part.isdigit() else part
                for part in re.split(r"(\d+)", name)]
    matches.sort(key=lambda item: version_key(item[0]), reverse=True)
    print(matches[0][0] + "\t" + matches[0][1])
PY
) || return 1
    [ -n "$line" ] || return 1
    printf '%s\n' "$line"
}

download_asset() {
    local name=$1 url=$2 dir=$3
    mkdir -p "$dir"
    if [ ! -s "$dir/$name" ]; then
        echo "downloading $name" >&2
        curl -fL --retry 3 --retry-delay 2 -o "$dir/$name.part" "$url"
        mv "$dir/$name.part" "$dir/$name"
    fi
    printf '%s\n' "$dir/$name"
}

# assets <regex> -> "name<TAB>url" for every matching release asset
assets() {
    local json
    json=$(api_json) || return 1
    python3 - "$json" "$1" <<'PY'
import json, re, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
pat = re.compile(sys.argv[2])
for item in data.get("assets", []):
    name = item.get("name", "")
    if pat.search(name):
        print(name + "\t" + item.get("browser_download_url", ""))
PY
}

dnf_cmd() {
    if command -v dnf5 >/dev/null 2>&1; then printf 'dnf5\n'; else printf 'dnf\n'; fi
}

protect_is_on() {
    [ -x /usr/libexec/gts9wifi-protect ] &&
        [ "$(/usr/libexec/gts9wifi-protect status 2>/dev/null)" = protected ]
}

lock_specs() {
    local line
    [ -d "$LOCKDIR" ] || return 0
    while IFS= read -r line; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        [ -n "$line" ] && printf '%s\n' "$line"
    done < <(cat "$LOCKDIR"/*.list 2>/dev/null || true)
}

# Run a dnf install with gts9wifi-protect suspended, then restore it even on
# failure or interrupt.  The port packages are in its exclude= list, so the
# install would otherwise be refused.
guarded_dnf() {
    if protect_is_on; then
        echo "port package protection temporarily disabled for this transaction"
        (
            trap '/usr/libexec/gts9wifi-protect on >/dev/null 2>&1 || true' EXIT
            trap 'exit 130' INT TERM
            /usr/libexec/gts9wifi-protect off >/dev/null 2>&1 ||
                { echo "could not disable port package protection" >&2; exit 1; }
            "$@"
        )
    else
        "$@"
    fi
}

# Versionlock entries hide the new NEVRA from dnf while the update is staged.
unlock_port_packages() {
    local dnf specs=() line
    [ -d "$LOCKDIR" ] || return 0
    while IFS= read -r line; do specs+=("$line"); done < <(lock_specs)
    [ ${#specs[@]} -gt 0 ] || return 0
    dnf=$(dnf_cmd)
    "$dnf" versionlock delete "${specs[@]}" >/dev/null 2>&1 ||
        echo "warning: could not drop versionlocks; update may be refused" >&2
}

guard_protect_was=0
guard_locks_dropped=0
guard_restore() {
    if [ "${guard_locks_dropped:-0}" -eq 1 ]; then
        apply_versionlock
        guard_locks_dropped=0
    fi
    if [ "${guard_protect_was:-0}" -eq 1 ]; then
        /usr/libexec/gts9wifi-protect on >/dev/null 2>&1 ||
            echo "warning: could not re-enable port package protection" >&2
        guard_protect_was=0
    fi
}

# Open a window for a port update: drop the dnf excludes and versionlocks,
# then re-apply both after the install.  The trap also restores protection if
# dnf fails or the command is interrupted.
update_begin() {
    if protect_is_on; then
        if /usr/libexec/gts9wifi-protect off >/dev/null 2>&1; then
            guard_protect_was=1
            echo "port package protection temporarily disabled"
        else
            echo "warning: could not disable port package protection" >&2
        fi
    fi
    trap 'guard_restore' EXIT
    trap 'guard_restore; exit 130' INT TERM
    guard_locks_dropped=1
    unlock_port_packages
}

update_end() {
    guard_restore
    trap - EXIT INT TERM
}

apply_versionlock() {
    local specs=() line
    [ -d "$LOCKDIR" ] || return 0
    while IFS= read -r line; do specs+=("$line"); done < <(lock_specs)
    [ ${#specs[@]} -gt 0 ] || return 0
    local dnf
    dnf=$(dnf_cmd)
    echo "locking: ${specs[*]}"
    if ! "$dnf" versionlock add "${specs[@]}" >/dev/null 2>&1; then
        echo "warning: versionlock unavailable or failed; install dnf-plugins-core/dnf5-plugins" >&2
    fi
}

battery_ok() {
    local cap ac
    cap=$(cat /sys/class/power_supply/*/capacity 2>/dev/null | sort -n | head -1 || true)
    ac=$(cat /sys/class/power_supply/*/online 2>/dev/null | grep -qx 1 && echo 1 || true)
    [ -n "$cap" ] || { echo "warning: battery capacity not found; cannot check charge" >&2; return 0; }
    echo "battery: ${cap}%${ac:+ (AC online)}"
    [ "$cap" -ge 60 ] || [ -n "$ac" ] || die "battery below 60%; charge before flashing"
}

part_dev() {
    local p=$1
    local d="/dev/disk/by-partlabel/$p"
    [ -e "$d" ] || die "missing partition label: $d"
    printf '%s\n' "$d"
}

check_part_sizes() {
    local p dev size expected
    need_cmd blockdev
    for p in "${BOOT_PARTS[@]}"; do
        dev=$(part_dev "$p")
        size=$(blockdev --getsize64 "$dev")
        expected=$(part_size "$p") || die "unknown partition size for $p"
        [ "$size" -eq "$expected" ] ||
            die "$p size $size, expected $expected"
    done
}

restore_boot() {
    local backup=$1 p
    echo "restoring boot partitions from $backup" >&2
    for p in "${BOOT_PARTS[@]}"; do
        dd if="$backup/$p.img" of="$(part_dev "$p")" bs=4M conv=fsync 2>/dev/null || return 1
    done
    sync
    return 0
}

restore_modules() {
    local backup=$1 t
    for t in "$backup"/modules-*.tar.gz; do
        [ -e "$t" ] || continue
        echo "restoring $(basename "$t")" >&2
        tar -C /lib/modules -xzf "$t" || true
    done
}

do_reboot() {
    [ "$reboot_after" -eq 1 ] || return 0
    echo "rebooting..."
    reboot
}

cmd_check() {
    [ -n "$tag" ] || tag=$DEFAULT_TAG
    echo "release tag: $tag"
    if ! api_json >/dev/null 2>&1; then
        echo "release metadata: unavailable" >&2
    else
        echo "assets:"
        python3 - "$(api_json)" <<'PY'
import json, sys
for a in json.load(open(sys.argv[1])).get("assets", []):
    print("  " + a.get("name", ""))
PY
    fi
    echo "installed:"
    rpm -q linux-gts9wifi gts9wifi-userspace 2>/dev/null || true
    if rpm -q libavcodec-free >/dev/null 2>&1; then
        echo "ffmpeg codecs: $(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE}' libavcodec-free)"
    else
        echo "ffmpeg codecs: not installed"
    fi
    if rpm -q libfprint gts9wifi-fingerprint >/dev/null 2>&1; then
        echo "fingerprint: $(rpm -q --qf '%{NAME}-%{VERSION}-%{RELEASE} ' libfprint gts9wifi-fingerprint)"
    else
        echo "fingerprint: not installed"
    fi
    if [ -e /dev/esfp0 ]; then
        echo "fingerprint device: /dev/esfp0 present"
    fi
    echo "running kernel: $(uname -r)"
    [ -d "/lib/modules/$(uname -r)" ] && echo "modules: present" || echo "modules: MISSING"
    if [ -f "$STATE/boot-version" ]; then
        echo "boot state:"; sed 's/^/  /' "$STATE/boot-version"
    else
        echo "boot state: no marker (unknown bundle)"
    fi
    battery_ok || true
}

cmd_userspace() {
    [ -n "$tag" ] || tag=$DEFAULT_TAG
    need_root
    need_cmd dnf
    local line name url rpm dir dline dname durl drpm
    line=$(asset '^gts9wifi-userspace-.*\.aarch64\.rpm$') ||
        line=$(asset '^gts9wifi-userspace-.*\.noarch\.rpm$') ||
        die "no userspace RPM in release $tag"
    IFS=$'\t' read -r name url <<<"$line"
    dline=$(asset '^gts9wifi-dynpart-[0-9].*\.aarch64\.rpm$') || true
    dname= durl= drpm=
    if [ -n "$dline" ]; then
        IFS=$'\t' read -r dname durl <<<"$dline"
    fi
    [ "$dry" -eq 0 ] || {
        echo "would install $name from $tag"
        [ -n "$dname" ] && echo "would install $dname from $tag"
        return 0
    }
    dir="$STATE/cache/$tag"
    rpm=$(download_asset "$name" "$url" "$dir")
    if [ -n "$dname" ]; then
        drpm=$(download_asset "$dname" "$durl" "$dir")
    fi
    echo "installing $name"
    update_begin
    if [ -n "$drpm" ]; then
        echo "installing $dname"
        dnf -y --nogpgcheck install "$rpm" "$drpm"
    else
        dnf -y --nogpgcheck install "$rpm"
    fi
    update_end
    glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true
    udevadm control --reload-rules >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
    for unit in gts9wifi-fast-charge-default.service \
                gts9wifi-usb-net-off.service gts9wifi-power.service; do
        if [ -f "/usr/lib/systemd/system/$unit" ]; then
            systemctl enable --now "$unit" >/dev/null 2>&1 || true
        fi
    done
    systemctl disable --now gts9wifi-usb-net.service >/dev/null 2>&1 || true
    echo "power defaults applied; USB debug net disabled"
    echo "  (create /etc/gts9wifi/usb-net-enabled to restore the debug link)"
    echo "userspace updated; log out and back in for the GNOME extension"
}

install_firefox_policy() {
    mkdir -p /etc/firefox/policies
    python3 - <<'PY'
import json
import os
import tempfile

path = "/etc/firefox/policies/policies.json"
data = {}
if os.path.exists(path) and os.path.getsize(path):
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception as e:
        raise SystemExit("cannot parse %s: %s" % (path, e))
prefs = data.setdefault("policies", {}).setdefault("Preferences", {})
prefs["media.hardware-video-decoding.force-enabled"] = True
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
PY
}

lock_ffmpeg_packages() {
    [ -d "$LOCKDIR" ] || return 0
    cat > "$LOCKDIR/50-ffmpeg.list" <<'EOF'
ffmpeg-free
libavcodec-free
libavdevice-free
libavfilter-free
libavformat-free
libavutil-free
libswresample-free
libswscale-free
EOF
}

cmd_ffmpeg() {
    [ -n "$tag" ] || tag=$DEFAULT_FFMPEG_TAG
    local line name url dir sums=""
    local -a entries=() rpms=()
    local pattern='^(ffmpeg-free|libav(codec|device|filter|format|util)-free|libsw(resample|scale)-free)-[0-9].*\.aarch64\.rpm$|^SHA256SUMS$'

    api_json >/dev/null || die "release $tag not found"
    mapfile -t entries < <(assets "$pattern")
    [ ${#entries[@]} -gt 0 ] || die "no FFmpeg RPMs in release $tag"

    if [ "$dry" -eq 1 ]; then
        echo "would install from $tag:"
        for line in "${entries[@]}"; do
            printf '  %s\n' "${line%%$'\t'*}"
        done
        return 0
    fi

    need_root
    need_cmd dnf
    need_cmd python3
    need_cmd sha256sum
    dir="$STATE/cache/$tag"
    for line in "${entries[@]}"; do
        IFS=$'\t' read -r name url <<<"$line"
        download_asset "$name" "$url" "$dir" >/dev/null
        case "$name" in
            SHA256SUMS) sums="$dir/$name" ;;
            *) rpms+=("$dir/$name") ;;
        esac
    done
    [ -n "$sums" ] || die "SHA256SUMS missing from release $tag"
    [ ${#rpms[@]} -gt 0 ] || die "no FFmpeg RPMs in release $tag"
    (cd "$dir" && sha256sum -c --ignore-missing SHA256SUMS) || die "checksum verification failed"

    echo "installing ${#rpms[@]} rebuilt FFmpeg packages"
    update_begin
    dnf -y --nogpgcheck install "${rpms[@]}"
    rpm -q libavcodec-free >/dev/null || die "libavcodec-free is not installed"
    install_firefox_policy
    lock_ffmpeg_packages
    update_end
    echo "FFmpeg installed and locked; restart Firefox to load the new libavcodec"
}

cmd_fingerprint() {
    [ -n "$libfprint_tag" ] || libfprint_tag=$DEFAULT_LIBFPRINT_TAG
    [ -n "$fingerprint_tag" ] || fingerprint_tag=$DEFAULT_FINGERPRINT_TAG
    local line name url dir lrpm frpm
    if [ "$calib_from_device" -eq 1 ] && [ -n "$calib_dir" ]; then
        die "use either --calib or --calib-from-device, not both"
    fi

    api_json "$libfprint_tag" >/dev/null || die "release $libfprint_tag not found"
    api_json "$fingerprint_tag" >/dev/null || die "release $fingerprint_tag not found"

    if [ "$dry" -eq 1 ]; then
        echo "would install libfprint from $libfprint_tag"
        echo "would install the runtime from $fingerprint_tag"
        if [ "$calib_from_device" -eq 1 ]; then
            echo "would import this unit's calibration from sec_efs"
        elif [ -n "$calib_dir" ]; then
            echo "would install calibration from $calib_dir"
        fi
        return 0
    fi

    need_root
    need_cmd dnf
    need_cmd python3
    need_cmd sha256sum

    dir="$STATE/cache/$libfprint_tag"
    line=$(asset_for "$libfprint_tag" '^SHA256SUMS$') ||
        die "no SHA256SUMS in $libfprint_tag"
    IFS=$'\t' read -r name url <<<"$line"
    download_asset "$name" "$url" "$dir" >/dev/null
    line=$(asset_for "$libfprint_tag" '^libfprint-[0-9].*\.aarch64\.rpm$') ||
        die "no libfprint RPM in $libfprint_tag"
    IFS=$'\t' read -r name url <<<"$line"
    lrpm=$(download_asset "$name" "$url" "$dir")
    (cd "$dir" && sha256sum -c --ignore-missing SHA256SUMS) ||
        die "libfprint checksum verification failed"

    dir="$STATE/cache/$fingerprint_tag"
    line=$(asset_for "$fingerprint_tag" '^SHA256SUMS$') ||
        die "no SHA256SUMS in $fingerprint_tag"
    IFS=$'\t' read -r name url <<<"$line"
    download_asset "$name" "$url" "$dir" >/dev/null
    line=$(asset_for "$fingerprint_tag" '^gts9wifi-fingerprint-[0-9].*\.aarch64\.rpm$') ||
        die "no fingerprint runtime RPM in $fingerprint_tag"
    IFS=$'\t' read -r name url <<<"$line"
    frpm=$(download_asset "$name" "$url" "$dir")
    (cd "$dir" && sha256sum -c --ignore-missing SHA256SUMS) ||
        die "fingerprint runtime checksum verification failed"

    echo "installing libfprint EL721 and the fingerprint runtime"
    update_begin
    dnf -y --nogpgcheck install "$lrpm" "$frpm" fprintd fprintd-pam

    if [ -d "$LOCKDIR" ]; then
        cat > "$LOCKDIR/40-fingerprint.list" <<'EOF'
libfprint
gts9wifi-fingerprint
EOF
    fi
    update_end

    systemctl daemon-reload >/dev/null 2>&1 || true
    for unit in gts9wifi-android-parts.service vendor.mount \
                vendor-firmware_mnt.mount \
                gts9wifi-fingerprint-runtime.service \
                gts9wifi-fingerprint-secure.service; do
        if [ -f "/usr/lib/systemd/system/$unit" ]; then
            systemctl enable "$unit" >/dev/null 2>&1 || true
        fi
    done
    systemctl start gts9wifi-android-parts.service >/dev/null 2>&1 || true
    systemctl start vendor.mount vendor-firmware_mnt.mount >/dev/null 2>&1 || true
    systemctl start gts9wifi-fingerprint-runtime.service >/dev/null 2>&1 ||
        echo "warning: runtime assembly failed; check /vendor and apnhlos mounts" >&2

    if [ "$calib_from_device" -eq 1 ]; then
        /usr/libexec/gts9wifi-fingerprint-runtime import-calibration ||
            echo "warning: sec_efs calibration import failed" >&2
    elif [ -n "$calib_dir" ]; then
        /usr/libexec/gts9wifi-fingerprint-runtime import-calibration "$calib_dir" ||
            echo "warning: calibration import from $calib_dir failed" >&2
    fi

    echo "fingerprint stack installed and locked"
    echo "  runtime assets: /var/lib/gts9wifi/fingerprint"
    echo "  calibration: calib.dat and egoptbds.dat in .../firmware (0600)"
    echo "  reboot, then enroll with GNOME Settings or: fprintd-enroll"
    echo "  GDM uses its own gdm-fingerprint PAM service;"
    echo "  do not enable authselect with-fingerprint (it adds a second prompt)"
}

cmd_kernel() {
    [ -n "$tag" ] || tag=$DEFAULT_TAG
    local line krpm_name krpm_url kzip_name kzip_url dir rpm zip imgdir p dev
    local backup running
    line=$(asset '^linux-gts9wifi-.*\.aarch64\.rpm$') ||
        die "no kernel RPM in release $tag"
    IFS=$'\t' read -r krpm_name krpm_url <<<"$line"
    line=$(asset '^gts9wifi-fedora-.*\.zip$') ||
        die "no TWRP boot bundle in release $tag"
    IFS=$'\t' read -r kzip_name kzip_url <<<"$line"

    if [ "$dry" -eq 1 ]; then
        echo "would download $krpm_name and $kzip_name from $tag"
        check_part_sizes || true
        battery_ok || true
        [ "$flash" -eq 1 ] && echo "would flash: ${BOOT_PARTS[*]}" || echo "pass --flash to write boot partitions"
        return 0
    fi

    need_root
    need_cmd unzip
    need_cmd blockdev
    battery_ok
    check_part_sizes
    running=$(uname -r)
    dir="$STATE/cache/$tag"
    rpm=$(download_asset "$krpm_name" "$krpm_url" "$dir")
    zip=$(download_asset "$kzip_name" "$kzip_url" "$dir")

    imgdir=$(mktemp -d /tmp/gts9wifi-bundle.XXXXXX)
    trap "rm -rf '$imgdir'" EXIT
    unzip -q "$zip" '*.img' SHA256SUMS -d "$imgdir"
    (cd "$imgdir" && sha256sum -c SHA256SUMS)

    if [ "$flash" -ne 1 ]; then
        echo "kernel pair verified; boot partitions NOT written and RPM NOT installed"
        echo "run again with --flash to update"
        return 0
    fi

    backup="$STATE/boot-backup/$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$backup"
    [ "$(df -Pk "$STATE" | awk 'NR==2 {print $4}')" -gt 524288 ] ||
        die "less than 512 MiB free under $STATE"
    echo "backing up boot partitions to $backup"
    for p in "${BOOT_PARTS[@]}"; do
        dd if="$(part_dev "$p")" of="$backup/$p.img" bs=4M conv=fsync 2>/dev/null
    done
    (cd "$backup" && sha256sum "${BOOT_PARTS[@]/%/.img}" > SHA256SUMS)
    tar -C /lib/modules -czf "$backup/modules-$running.tar.gz" "$running"
    rpm -qa | grep -E 'linux-gts9wifi|gts9wifi-userspace' > "$backup/rpm-list.txt" || true

    if [ "$flash" -eq 1 ]; then
        echo "flashing boot/init_boot/vendor_boot/dtbo (vbmeta untouched)"
        for p in "${BOOT_PARTS[@]}"; do
            dd if="$imgdir/$p.img" of="$(part_dev "$p")" bs=4M conv=fsync 2>/dev/null || {
                restore_boot "$backup" || true
                die "failed writing $p; restore attempted"
            }
        done
        sync
        echo "verifying written partitions"
        for p in "${BOOT_PARTS[@]}"; do
            dd if="$(part_dev "$p")" of="$imgdir/read-$p.img" bs=4M 2>/dev/null
            cmp -s "$imgdir/$p.img" "$imgdir/read-$p.img" ||
                { restore_boot "$backup" || true; die "readback mismatch for $p"; }
        done
    else
        echo "boot bundle verified; not writing (pass --flash)"
    fi

    echo "installing $krpm_name"
    if rpm -q linux-gts9wifi >/dev/null 2>&1; then
        rpm -Uvh --replacepkgs --replacefiles "$rpm" || {
            [ "$flash" -eq 1 ] && restore_boot "$backup" || true
            restore_modules "$backup"
            die "kernel RPM install failed"
        }
    else
        guarded_dnf dnf -y --nogpgcheck install "$rpm" || {
            [ "$flash" -eq 1 ] && restore_boot "$backup" || true
            restore_modules "$backup"
            die "kernel RPM install failed"
        }
    fi

    mkdir -p "$STATE"
    {
        printf 'tag=%s\n' "$tag"
        printf 'date=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'kernel=%s\n' "$krpm_name"
        printf 'bundle=%s\n' "$kzip_name"
    } > "$STATE/boot-version"
    echo "kernel update complete; reboot to use it"
    do_reboot
}

cmd_rollback() {
    local backup p
    need_root
    backup=$backup_arg
    if [ -z "$backup" ]; then
        backup=$(ls -1dt "$STATE"/boot-backup/* 2>/dev/null | head -1 || true)
    fi
    [ -n "$backup" ] && [ -d "$backup" ] || die "no boot backup found"
    for p in "${BOOT_PARTS[@]}"; do
        [ -f "$backup/$p.img" ] || die "missing $backup/$p.img"
    done
    check_part_sizes
    if [ "$dry" -eq 1 ]; then
        echo "would restore ${BOOT_PARTS[*]} from $backup"
        return 0
    fi
    restore_boot "$backup" || die "restore failed"
    restore_modules "$backup"
    rm -f "$STATE/boot-version"
    echo "rollback complete; reboot to use the previous kernel"
    do_reboot
}

installed_evr() {
    rpm -q --qf '%{VERSION}-%{RELEASE}' "$1" 2>/dev/null || true
}

asset_evr() {
    local pkg=$1 file=$2 evr
    evr=${file#"$pkg"-}
    evr=${evr%.aarch64.rpm}
    evr=${evr%.noarch.rpm}
    printf '%s\n' "$evr"
}

is_newer() {
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
    [ "$1" = "$2" ] && return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$2" ]
}

asset_evr_for() {
    local line name
    line=$(asset_for "$1" "$2") || return 1
    name=${line%%$'\t'*}
    asset_evr "$3" "$name"
}

component_update_available() {
    [ -n "${1:-}" ] && [ -n "${2:-}" ] && is_newer "$1" "$2"
}

report_component() {
    local label=$1 inst=${2:-} avail=${3:-} note=${4:-} status
    if [ -z "$inst" ]; then
        printf '%-13s %-28s %-28s %s\n' "$label" '-' "${avail:-unknown}" 'not installed'
        return 0
    fi
    if [ -z "$avail" ]; then
        printf '%-13s %-28s %-28s %s\n' "$label" "$inst" 'unknown' 'release unavailable'
        return 0
    fi
    if [ "$inst" = "$avail" ]; then
        status='up to date'
    elif is_newer "$inst" "$avail"; then
        status='UPDATE'
        updates=$((updates + 1))
    else
        status='newer than release'
    fi
    if [ -n "$note" ] && [ "$status" = UPDATE ]; then
        printf '%-13s %-28s %-28s %s (%s)\n' "$label" "$inst" "$avail" "$status" "$note"
    else
        printf '%-13s %-28s %-28s %s\n' "$label" "$inst" "$avail" "$status"
    fi
}

cmd_check_all() {
    [ -n "$tag" ] || tag=$DEFAULT_TAG
    local latest=$tag
    local ffmpeg_tag=$DEFAULT_FFMPEG_TAG
    local lf_tag=${libfprint_tag:-$DEFAULT_LIBFPRINT_TAG}
    local fp_tag=${fingerprint_tag:-$DEFAULT_FINGERPRINT_TAG}
    local updates=0 avail
    echo "release tags: latest=$latest ffmpeg=$ffmpeg_tag"
    echo "              libfprint=$lf_tag fingerprint=$fp_tag"
    printf '%-13s %-28s %-28s %s\n' component installed available status

    avail=$(asset_evr_for "$latest" '^gts9wifi-userspace-.*\.(aarch64|noarch)\.rpm$' gts9wifi-userspace || true)
    report_component userspace "$(installed_evr gts9wifi-userspace)" "$avail"
    avail=$(asset_evr_for "$latest" '^gts9wifi-dynpart-[0-9].*\.aarch64\.rpm$' gts9wifi-dynpart || true)
    report_component dynpart "$(installed_evr gts9wifi-dynpart)" "$avail"
    avail=$(asset_evr_for "$latest" '^libcamera-[0-9].*\.aarch64\.rpm$' libcamera || true)
    report_component libcamera "$(installed_evr libcamera)" "$avail"
    avail=$(asset_evr_for "$fp_tag" '^gts9wifi-fingerprint-[0-9].*\.aarch64\.rpm$' gts9wifi-fingerprint || true)
    report_component fingerprint "$(installed_evr gts9wifi-fingerprint)" "$avail"
    avail=$(asset_evr_for "$lf_tag" '^libfprint-[0-9].*\.aarch64\.rpm$' libfprint || true)
    report_component libfprint "$(installed_evr libfprint)" "$avail"
    avail=$(asset_evr_for "$ffmpeg_tag" '^libavcodec-free-[0-9].*\.aarch64\.rpm$' libavcodec-free || true)
    report_component ffmpeg "$(installed_evr libavcodec-free)" "$avail"
    avail=$(asset_evr_for "$latest" '^linux-gts9wifi-.*\.aarch64\.rpm$' linux-gts9wifi || true)
    report_component kernel "$(installed_evr linux-gts9wifi)" "$avail" 'needs flash'

    echo "running kernel: $(uname -r)"
    if [ "$updates" -eq 0 ]; then
        echo "all installed components are up to date"
    else
        echo "$updates update(s) available; run 'gts9wifi-update all' for the RPM components"
    fi
    echo "kernel updates are never installed by 'all'; use the kernel command with --flash"
}

cmd_libcamera() {
    [ -n "$tag" ] || tag=$DEFAULT_TAG
    local -a installed=() rpms=() names=() urls=()
    local p pat line name url dir="$STATE/cache/$tag"
    local libcamera_name='' inst avail
    need_root
    need_cmd dnf
    need_cmd rpm
    need_cmd sha256sum
    for p in libcamera libcamera-ipa libcamera-tools libcamera-gstreamer \
             libcamera-v4l2 libcamera-qcam python3-libcamera; do
        rpm -q --quiet "$p" 2>/dev/null && installed+=("$p")
    done
    [ ${#installed[@]} -gt 0 ] || {
        echo "libcamera is not installed; nothing to do"
        return 0
    }
    line=$(asset_for "$tag" '^libcamera-[0-9].*\.aarch64\.rpm$') ||
        die "no libcamera asset in release $tag"
    IFS=$'\t' read -r libcamera_name url <<<"$line"
    inst=$(installed_evr libcamera)
    avail=$(asset_evr libcamera "$libcamera_name")
    if ! component_update_available "$inst" "$avail"; then
        echo "libcamera $inst is up to date (release $avail)"
        return 0
    fi
    for p in "${installed[@]}"; do
        if [ "$p" = libcamera ]; then
            pat='^libcamera-[0-9].*\.aarch64\.rpm$'
        else
            pat="^${p}-[0-9].*\.aarch64\.rpm$"
        fi
        line=$(asset_for "$tag" "$pat") || die "no $p asset in release $tag"
        IFS=$'\t' read -r name url <<<"$line"
        names+=("$name")
        urls+=("$url")
    done
    if [ "$dry" -eq 1 ]; then
        echo "would install from $tag:"
        printf '  %s\n' "${names[@]}"
        return 0
    fi
    local i
    for i in "${!names[@]}"; do
        rpms+=("$(download_asset "${names[i]}" "${urls[i]}" "$dir")")
    done
    if line=$(asset_for "$tag" '^LIBCAMERA-SHA256SUMS$' 2>/dev/null); then
        IFS=$'\t' read -r name url <<<"$line"
        download_asset "$name" "$url" "$dir" >/dev/null
        (cd "$dir" && sha256sum -c --ignore-missing LIBCAMERA-SHA256SUMS) ||
            die "libcamera checksum verification failed"
    fi
    echo "installing libcamera $avail"
    update_begin
    dnf -y --nogpgcheck install "${rpms[@]}"
    if [ -d "$LOCKDIR" ]; then
        printf '%s\n' "${installed[@]}" > "$LOCKDIR/60-libcamera.list"
    fi
    update_end
    echo "libcamera updated; reboot or log out so PipeWire loads the new library"
}

cmd_calib() {
    need_root
    [ -x /usr/libexec/gts9wifi-fingerprint-runtime ] ||
        die "fingerprint runtime is not installed; run 'gts9wifi-update fingerprint' first"
    if [ "$calib_from_device" -eq 1 ] && [ -n "$calib_dir" ]; then
        die "use either --calib or --calib-from-device, not both"
    elif [ "$calib_from_device" -eq 1 ]; then
        /usr/libexec/gts9wifi-fingerprint-runtime import-calibration
    elif [ -n "$calib_dir" ]; then
        /usr/libexec/gts9wifi-fingerprint-runtime import-calibration "$calib_dir"
    else
        die "pass --calib-from-device or --calib DIR"
    fi
}

cmd_all() {
    need_root
    local latest=${tag:-$DEFAULT_TAG}
    local ffmpeg_tag=$DEFAULT_FFMPEG_TAG
    local lf_tag=${libfprint_tag:-$DEFAULT_LIBFPRINT_TAG}
    local fp_tag=${fingerprint_tag:-$DEFAULT_FINGERPRINT_TAG}
    local up_userspace=0 up_libcamera=0 up_fprint=0 up_ffmpeg=0
    local inst avail

    inst=$(installed_evr gts9wifi-userspace)
    avail=$(asset_evr_for "$latest" '^gts9wifi-userspace-.*\.(aarch64|noarch)\.rpm$' gts9wifi-userspace || true)
    if component_update_available "$inst" "$avail"; then up_userspace=1; fi
    inst=$(installed_evr gts9wifi-dynpart)
    avail=$(asset_evr_for "$latest" '^gts9wifi-dynpart-[0-9].*\.aarch64\.rpm$' gts9wifi-dynpart || true)
    if component_update_available "$inst" "$avail"; then up_userspace=1; fi

    inst=$(installed_evr libcamera)
    avail=$(asset_evr_for "$latest" '^libcamera-[0-9].*\.aarch64\.rpm$' libcamera || true)
    if component_update_available "$inst" "$avail"; then up_libcamera=1; fi

    inst=$(installed_evr libfprint)
    avail=$(asset_evr_for "$lf_tag" '^libfprint-[0-9].*\.aarch64\.rpm$' libfprint || true)
    if component_update_available "$inst" "$avail"; then up_fprint=1; fi
    inst=$(installed_evr gts9wifi-fingerprint)
    avail=$(asset_evr_for "$fp_tag" '^gts9wifi-fingerprint-[0-9].*\.aarch64\.rpm$' gts9wifi-fingerprint || true)
    if component_update_available "$inst" "$avail"; then up_fprint=1; fi

    inst=$(installed_evr libavcodec-free)
    avail=$(asset_evr_for "$ffmpeg_tag" '^libavcodec-free-[0-9].*\.aarch64\.rpm$' libavcodec-free || true)
    if component_update_available "$inst" "$avail"; then up_ffmpeg=1; fi

    if [ "$up_userspace$up_libcamera$up_fprint$up_ffmpeg" = 0000 ]; then
        echo "all installed components are up to date"
    elif [ "$dry" -eq 1 ]; then
        echo "would update:"
        if [ "$up_userspace" -eq 1 ]; then echo "  userspace/dynpart ($latest)"; fi
        if [ "$up_libcamera" -eq 1 ]; then echo "  libcamera ($latest)"; fi
        if [ "$up_fprint" -eq 1 ]; then echo "  fingerprint/libfprint ($lf_tag, $fp_tag)"; fi
        if [ "$up_ffmpeg" -eq 1 ]; then echo "  ffmpeg ($ffmpeg_tag)"; fi
    else
        tag=$latest
        if [ "$up_userspace" -eq 1 ]; then
            echo "== userspace =="
            cmd_userspace
        fi
        if [ "$up_libcamera" -eq 1 ]; then
            echo "== libcamera =="
            cmd_libcamera
        fi
        tag=
        if [ "$up_fprint" -eq 1 ]; then
            echo "== fingerprint =="
            cmd_fingerprint
        fi
        if [ "$up_ffmpeg" -eq 1 ]; then
            echo "== ffmpeg =="
            cmd_ffmpeg
        fi
        echo "component updates complete"
        echo "reboot or log out for libcamera and the GNOME extension"
    fi
    inst=$(installed_evr linux-gts9wifi)
    avail=$(asset_evr_for "$latest" '^linux-gts9wifi-.*\.aarch64\.rpm$' linux-gts9wifi || true)
    if component_update_available "$inst" "$avail"; then
        echo "kernel $avail is also available; use the kernel command with --flash"
    fi
}

case "$cmd" in
    check) cmd_check ;;
    check-all) cmd_check_all ;;
    all) cmd_all ;;
    userspace) cmd_userspace ;;
    wifi) need_root; /usr/libexec/gts9wifi-wifi-bdf ;;
    ffmpeg) cmd_ffmpeg ;;
    libcamera) cmd_libcamera ;;
    fingerprint) cmd_fingerprint ;;
    calib) cmd_calib ;;
    kernel) cmd_kernel ;;
    rollback) cmd_rollback ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd" ;;
esac
