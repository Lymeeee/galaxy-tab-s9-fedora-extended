[Unit]
Description=Apply the GTS9 keyboard V37 firmware after the root filesystem is up
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/lib/firmware/keyboard_stm/stm32_gts9family.bin

[Service]
Type=oneshot
ExecStart=/usr/libexec/gts9wifi-keyboard-fw

[Install]
WantedBy=multi-user.target
