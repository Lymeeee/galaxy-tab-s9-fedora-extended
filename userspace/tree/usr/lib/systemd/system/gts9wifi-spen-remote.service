[Unit]
Description=Pair the docked S Pen and publish its battery
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
RuntimeDirectory=gts9wifi
RuntimeDirectoryMode=0755
ExecStart=/usr/libexec/gts9wifi-spen-remote
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
