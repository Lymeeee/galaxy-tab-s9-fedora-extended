# SPDX-License-Identifier: MIT
#
# The charger driver's switches (fast_charge, charge_limit, charge_bypass) are
# root-only, so the session cannot change them from its own UI (the
# gnome-gts9wifi extension and /usr/libexec/gts9wifi-device-control).  Open
# them to group video, the same group 71-gts9wifi-touchscreen-perms.rules uses,
# because that is the group the seat user already has.  ($$ is a literal $ for
# udev.)
#
# The i2c client device is created at boot, but the driver creates these
# attributes only when it probes - and a driver rebind recreates them with
# the kernel's root-only defaults.  The add event predates the attributes,
# so match bind as well or the user session cannot write the switches.
ACTION=="add|change|bind", SUBSYSTEM=="i2c", KERNEL=="6-0049", \
	RUN+="/bin/sh -c 'for a in fast_charge charge_limit charge_bypass; do f=%S%p/$$a; [ -e $$f ] && chgrp video $$f && chmod 0664 $$f; done; true'"

# charge_hold belongs to the SM5440 direct-charge device (4-0063).
ACTION=="add|change|bind", SUBSYSTEM=="i2c", KERNEL=="4-0063", \
	RUN+="/bin/sh -c 'for a in charge_hold charge_hold_status; do f=%S%p/$$a; [ -e $$f ] && chgrp video $$f && chmod 0664 $$f; done; true'"

# The user-session charge mode blanks the panel through the DRM connector.
ACTION=="add|change", SUBSYSTEM=="drm", KERNEL=="card0-DSI-1", \
	RUN+="/bin/sh -c 'f=/sys/class/drm/card0-DSI-1/dpms; [ -e $$f ] && chgrp video $$f && chmod 0664 $$f; true'"
