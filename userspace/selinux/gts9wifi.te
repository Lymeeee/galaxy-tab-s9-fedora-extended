module gts9wifi 1.0;

require {
    type fprintd_t;
    type sysfs_t;
    type systemd_sleep_t;
    type systemd_systemctl_exec_t;
    type unconfined_t;
    type unconfined_service_t;
    type init_t;
    type udev_t;
    type device_t;
    type tmpfs_t;
    class dir { add_name create getattr mounton open read remove_name rmdir search setattr write };
    class file { create execute execute_no_trans getattr map open read rename setattr unlink write };
    class chr_file { getattr ioctl lock map open read relabelto write };
    class filesystem { associate };
    class binder { set_context_mgr };
}

type gts9wifi_fingerprint_run_t;
type gts9wifi_fingerprint_device_t;

# Lease handshake between libfprint and the GNOME target: active/light are
# written by fprintd, ready/presented/cancel by the UI broker.
allow fprintd_t gts9wifi_fingerprint_run_t:dir {
    add_name getattr open read remove_name search write
};
allow fprintd_t gts9wifi_fingerprint_run_t:file {
    create getattr open read rename setattr unlink write
};
# The GNOME session reads the leases, the UI broker writes its acknowledgements
# and clear state; both are already unconfined domains.  systemd creates and
# removes the RuntimeDirectory itself.
allow { unconfined_t unconfined_service_t init_t } gts9wifi_fingerprint_run_t:dir {
    add_name create getattr mounton open read remove_name rmdir search setattr write
};
allow { unconfined_t unconfined_service_t init_t } gts9wifi_fingerprint_run_t:file {
    create getattr open read rename setattr unlink write
};
# /run is tmpfs; the RuntimeDirectory files get labeled inside it.
allow gts9wifi_fingerprint_run_t tmpfs_t:filesystem associate;

# /dev/esfp0 is the EL721 sensor; /dev/tee0 is the qcom TEE the trusted app
# talks through.
allow fprintd_t gts9wifi_fingerprint_device_t:chr_file {
    getattr ioctl lock map open read write
};
# The secure-start owner process (secure-owner --boot) is the TEE client.
allow unconfined_service_t gts9wifi_fingerprint_device_t:chr_file {
    getattr ioctl lock map open read write
};
# udevadm/systemd/user tools stat the nodes; the custom type is not part of
# the unconfined blanket.
allow { unconfined_t init_t } gts9wifi_fingerprint_device_t:chr_file {
    getattr ioctl lock map open read write
};

# systemd-udevd labels new device nodes from file_contexts itself; the fs
# association is devtmpfs (device_t).
allow udev_t gts9wifi_fingerprint_device_t:chr_file { getattr relabelto write };
allow gts9wifi_fingerprint_device_t device_t:filesystem associate;

# spdaemon waits for a binder context manager on /dev/vndbinder.
allow unconfined_service_t self:binder set_context_mgr;

# The EL721 driver exposes sensor_power as a sysfs attribute.  sysfs cannot
# be relabeled, so scope those writes to the fprintd daemon.
allow fprintd_t sysfs_t:dir { add_name search write };
allow fprintd_t sysfs_t:file { create getattr open read setattr write };

# The camera suspend hook clears a stale failed unit with systemctl.
allow systemd_sleep_t systemd_systemctl_exec_t:file {
    execute execute_no_trans getattr map open read
};
