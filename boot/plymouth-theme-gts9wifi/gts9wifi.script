spinner.sprite = Sprite(spinner.images[0]);
spinner.sprite.SetPosition(screen.x + screen.width / 2 - spinner.size / 2, screen.y + screen.height * 0.72 - spinner.size / 2, 20);
spinner.frame = 0;

fedora.icon.image = Image("fedora-icon.png");
fedora.icon.size = Math.Int(screen.width * 46 / 960);
fedora.icon.sprite = Sprite(fedora.icon.image.Scale(fedora.icon.size, fedora.icon.size));
fedora.word.image = Image("fedora-wordmark.png");
fedora.word.height = Math.Int(screen.height * 32 / 600);
fedora.word.width = Math.Int(fedora.word.image.GetWidth() * fedora.word.height / fedora.word.image.GetHeight());
fedora.word.sprite = Sprite(fedora.word.image.Scale(fedora.word.width, fedora.word.height));
fedora.gap = Math.Int(screen.width * 10 / 960);
fedora.total = fedora.icon.size + fedora.gap + fedora.word.width;
fedora.x = screen.x + screen.width / 2 - fedora.total / 2;
fedora.y = screen.y + screen.height * 0.88;
fedora.icon.sprite.SetPosition(fedora.x, fedora.y - fedora.icon.size / 2, 10);
fedora.word.sprite.SetPosition(fedora.x + fedora.icon.size + fedora.gap, fedora.y - fedora.word.height / 2, 10);

fun refresh_callback()
  {
    spinner.frame += 1;
    if (spinner.frame >= 84)
      spinner.frame = 0;
    spinner.sprite.SetImage(spinner.images[spinner.frame]);
  }

Plymouth.SetRefreshFunction(refresh_callback);

fun no_message(text)
  {
  }

Plymouth.SetDisplayMessageFunction(no_message);
Plymouth.SetHideMessageFunction(no_message);
