# GTS9 boot splash (Plymouth script theme)
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen.width = Window.GetWidth();
screen.height = Window.GetHeight();
screen.x = Window.GetX();
screen.y = Window.GetY();

samsung.image = Image("samsung.png");
samsung.width = Math.Int(screen.width * 320 / 960);
samsung.height = Math.Int(samsung.image.GetHeight() * samsung.width / samsung.image.GetWidth());
samsung.sprite = Sprite(samsung.image.Scale(samsung.width, samsung.height));

spinner.size = Math.Int(screen.width * 42 / 960);
spinner.top = screen.height * 0.72 - spinner.size / 2;
samsung.y = spinner.top / 2 - samsung.height / 2;
samsung.sprite.SetPosition(screen.x + screen.width / 2 - samsung.width / 2, screen.y + samsung.y, 10);

