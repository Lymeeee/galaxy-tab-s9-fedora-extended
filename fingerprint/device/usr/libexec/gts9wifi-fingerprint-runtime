#!/usr/bin/python3
"""Assemble the fingerprint secure-start runtime from this tablet's own Android.

  gts9wifi-fingerprint-runtime assemble   copy into /var/lib/gts9wifi/fingerprint
  gts9wifi-fingerprint-runtime check      show what is present (read-only)
  gts9wifi-fingerprint-runtime import-calibration [DIR]
                                          import this unit's calibration

The SPU needs Samsung's sec_nvm and spdaemon running before Keymaster can be
configured (see docs/gts9wifi/FINGERPRINT.md).  They are Android binaries, so
they run under Android's bootstrap linker with the libraries they need, and
the dualfp trusted app is loaded from its signed segments.  Nothing of that is
in this repository: everything is copied from the tablet's own read-only
partitions (vendor, system, apnhlos, sec_efs).  The per-unit calibration is
sec_efs/biometrics/meta/egis_calibration_data.bin (stored as calib.dat) and
egoptbds.dat from the same partition when present.  super is only ever mapped
read-only.
"""
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

DEST = Path('/var/lib/gts9wifi/fingerprint')
RUNTIME = DEST / 'runtime'
FIRMWARE = DEST / 'firmware'
SYSTEM_MNT = Path('/run/gts9wifi-android-system')
VENDOR = Path('/vendor')
TA_DIR = Path('/vendor/firmware_mnt/image')
CALIB_NAMES = ('calib.dat', 'egis_calibration_data.bin')
BDS_NAME = 'egoptbds.dat'
SEC_EFS_DEVICES = (Path('/dev/disk/by-partlabel/sec_efs'),
                   Path('/dev/block/by-name/sec_efs'))

BINARIES = {'bin/linker64': 'system/bin/bootstrap/linker64',
            'bin/sec_nvm': 'vendor/bin/sec_nvm',
            'bin/spdaemon': 'vendor/bin/spdaemon',
            # This vendor's spdaemon waits for a context manager on
            # /dev/vndbinder before it starts the SPU.
            'bin/vndservicemanager': 'vendor/bin/vndservicemanager'}
# Trusted apps the EL721 bridge loads: dualfp (the matcher), hwvault (template
# keys, restored from the K250A) and skeymast (gatekeeper / HAT key).
TA_SEGMENTS = [f'{ta}.{seg}' for ta in ('dualfp', 'hwvault', 'skeymast')
               for seg in [f'b{i:02d}' for i in range(9)] + ['mdt']]
# The SPSS firmware qcom_spss requests as spss1p.mdt (the supervisor points
# the firmware loader at FIRMWARE before loading the module).
TA_SEGMENTS += [f'spss1p.b{i:02d}' for i in range(3)] + ['spss1p.mdt']


def system_root():
    root = SYSTEM_MNT / 'system'
    if root.is_dir():
        return root
    if not Path('/dev/mapper/system').exists():
        subprocess.run(['/usr/libexec/gts9wifi-android-parts', 'map', 'system'],
                       check=True)
    SYSTEM_MNT.mkdir(mode=0o700, exist_ok=True)
    # ext4 (noload: never replay a journal) or erofs, which has no noload.
    fstype = subprocess.run(['blkid', '-s', 'TYPE', '-o', 'value', '/dev/mapper/system'],
                            capture_output=True, text=True).stdout.strip()
    opts = 'ro,nodev,nosuid,noexec' + (',noload' if fstype == 'ext4' else '')
    subprocess.run(['mount', '-o', opts, '/dev/mapper/system', str(SYSTEM_MNT)],
                   check=True)
    return root


def needed(path):
    """DT_NEEDED entries of an ELF64 little-endian file."""
    import struct
    data = path.read_bytes()
    shoff = struct.unpack_from('<Q', data, 0x28)[0]
    shentsize, shnum = struct.unpack_from('<HH', data, 0x3a)
    sections = [struct.unpack_from('<IIQQQQIIQQ', data, shoff + i * shentsize)
                for i in range(shnum)]
    out = []
    for sec in sections:
        if sec[1] != 6:                       # SHT_DYNAMIC
            continue
        strtab = sections[sec[6]][4]
        for i in range(sec[5] // 16):
            tag, val = struct.unpack_from('<qQ', data, sec[4] + i * 16)
            if tag == 1:                      # DT_NEEDED
                end = data.index(b'\0', strtab + val)
                out.append(data[strtab + val:end].decode())
    return out


def sources(system):
    """Map of runtime-relative path -> source file on the tablet."""
    base = {'system': system, 'vendor': VENDOR}
    files = {dst: base[src.split('/')[0]] / src.split('/', 1)[1]
             for dst, src in BINARIES.items()}
    search = [VENDOR / 'lib64', system / 'lib64/bootstrap', system / 'lib64']
    todo = [files['bin/sec_nvm'], files['bin/spdaemon'],
            files['bin/vndservicemanager']]
    while todo:
        for name in needed(todo.pop()):
            dst = f'lib64/{name}'
            if dst in files:
                continue
            found = next((d / name for d in search if (d / name).exists()), None)
            if found is None:
                sys.exit(f'missing library {name}')
            files[dst] = found
            todo.append(found)
    # ld-android.so is the linker's own soname, not a DT_NEEDED of the tools.
    files['lib64/ld-android.so'] = system / 'lib64/ld-android.so'
    # The vendor libhardware_legacy pulls binder/hidl/suspend HAL and leaves
    # spdaemon spinning before it opens /dev/vndbinder; ship the no-op stub.
    files['lib64/libhardware_legacy.so'] = \
        Path('/usr/lib/gts9wifi/fingerprint/libhardware_legacy.so')
    return files


def copy(src, dst, mode):
    dst.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    # Write beside and rename: a running daemon's file cannot be rewritten
    # in place (ETXTBSY), and a reader never sees a half-copied file.
    tmp = dst.with_name(dst.name + '.new')
    shutil.copyfile(src, tmp)
    os.chmod(tmp, mode)
    os.replace(tmp, dst)
    return hashlib.sha256(dst.read_bytes()).hexdigest()


def manifest_add(rel):
    manifest = DEST / 'SHA256SUMS'
    if not manifest.is_file():
        raise RuntimeError('runtime manifest missing; run assemble first')
    digest = hashlib.sha256((DEST / rel).read_bytes()).hexdigest()
    lines = [line for line in manifest.read_text().splitlines()
             if line.split(None, 1)[-1] != rel]
    lines.append(f'{digest}  {rel}')
    manifest.write_text('\n'.join(lines) + '\n')
    os.chmod(manifest, 0o600)


def pick(root, names):
    for name in names:
        path = root / name
        if path.is_file():
            return path
    return None


def import_calibration(source=None):
    """Import this unit's sec_efs calibration, never another unit's."""
    if os.geteuid() != 0:
        sys.exit('root required')
    if not (DEST / 'SHA256SUMS').is_file():
        sys.exit('runtime manifest missing; run assemble first')
    calib = None
    bds = None
    mounted = None
    temporary = None
    try:
        if source is not None:
            src = Path(source)
            if src.is_file():
                if src.name in CALIB_NAMES:
                    calib = src
                elif src.name == BDS_NAME:
                    bds = src
                else:
                    sys.exit(f'unexpected calibration file: {src.name}')
            elif src.is_dir():
                calib = pick(src, CALIB_NAMES)
                bds = pick(src, (BDS_NAME,))
            else:
                sys.exit(f'no such file or directory: {src}')
        else:
            device = next((p for p in SEC_EFS_DEVICES if p.exists()), None)
            if device is None:
                sys.exit('sec_efs not found; pass a directory containing '
                         'calib.dat and egoptbds.dat')
            temporary = tempfile.mkdtemp(prefix='gts9wifi-sec-efs-')
            for options in ('ro,noload', 'ro'):
                if subprocess.run(['mount', '-o', options, str(device),
                                   temporary],
                                  capture_output=True).returncode == 0:
                    mounted = temporary
                    break
            if mounted is None:
                sys.exit(f'could not mount {device} read-only')
            root = Path(temporary)
            calib = pick(root / 'biometrics/meta', CALIB_NAMES)
            bds = pick(root / 'biometrics/meta', (BDS_NAME,))
            if bds is None:
                bds = pick(root / 'biometrics', (BDS_NAME,))
            if bds is None:
                bds = next(iter(root.rglob(BDS_NAME)), None)
            if bds is None:
                for extra in (Path('/mnt/vendor/persist'),
                              Path('/vendor/firmware'),
                              Path('/vendor/etc/firmware')):
                    if extra.is_dir():
                        bds = pick(extra, (BDS_NAME,))
                        if bds is not None:
                            break
        if calib is None:
            sys.exit('calib.dat / egis_calibration_data.bin not found')
        FIRMWARE.mkdir(mode=0o700, parents=True, exist_ok=True)
        for src, rel in ((calib, 'firmware/calib.dat'),
                         (bds, 'firmware/egoptbds.dat')):
            if src is None:
                continue
            digest = copy(src, DEST / rel, 0o600)
            manifest_add(rel)
            print(f'{rel}: {src} ({digest})')
        if bds is None:
            print('warning: egoptbds.dat not found; enrollment will fail '
                  'until it is supplied with: gts9wifi-fingerprint-runtime '
                  'import-calibration DIR')
    finally:
        if mounted is not None:
            subprocess.run(['umount', mounted], capture_output=True)
        if temporary is not None:
            shutil.rmtree(temporary, ignore_errors=True)


def assemble():
    if os.geteuid() != 0:
        sys.exit('root required')
    system = system_root()
    DEST.mkdir(mode=0o700, parents=True, exist_ok=True)
    manifest = []
    for dst, src in sorted(sources(system).items()):
        mode = 0o755 if dst.startswith('bin/') else 0o644
        manifest.append(f'{copy(src, RUNTIME / dst, mode)}  runtime/{dst}')
    for name in TA_SEGMENTS:
        manifest.append(f'{copy(TA_DIR / name, FIRMWARE / name, 0o644)}  firmware/{name}')
    for name in ('calib.dat', 'egoptbds.dat'):
        path = FIRMWARE / name
        if path.is_file():
            manifest.append(f'{hashlib.sha256(path.read_bytes()).hexdigest()}  '
                            f'firmware/{name}')
    (DEST / 'SHA256SUMS').write_text('\n'.join(manifest) + '\n')
    os.chmod(DEST / 'SHA256SUMS', 0o600)
    print(f'{len(manifest)} files in {DEST}')
    for blob in ('calib.dat', 'egoptbds.dat'):
        if not (FIRMWARE / blob).exists():
            print(f'still missing: firmware/{blob} '
                  '(run: gts9wifi-fingerprint-runtime import-calibration)')


def check():
    for blob in sorted(DEST.rglob('*')):
        if blob.is_file():
            print(blob.relative_to(DEST))


if __name__ == '__main__':
    command = sys.argv[1] if len(sys.argv) > 1 else ''
    if command == 'assemble':
        assemble()
    elif command == 'check':
        check()
    elif command == 'import-calibration':
        import_calibration(sys.argv[2] if len(sys.argv) > 2 else None)
    else:
        sys.exit(__doc__)
