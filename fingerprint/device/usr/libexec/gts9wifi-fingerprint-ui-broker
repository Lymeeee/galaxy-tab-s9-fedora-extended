#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Availability lease for the EL721 optical target.

Only the active local seat's UID can publish a lease for that session.  A
client can allow or suppress optical capture and cancel the current action;
it never receives a template, identity or authentication result.  The short
lease fails closed if the overlay, this service or logind disappears.
"""

import os
import time
from pathlib import Path

NAME = "io.github.lymeeee.Gts9wifiFingerprintUI"
PATH = "/io/github/lymeeee/Gts9wifiFingerprintUI"
LEASE = Path("/run/gts9wifi-fingerprint-ui/ready")
PRESENTED = Path("/run/gts9wifi-fingerprint-ui/presented")
CANCEL = Path("/run/gts9wifi-fingerprint-ui/cancel")
LIGHT_REQUEST = Path("/run/gts9wifi-fingerprint/light")
ACTIVE_LEASE = Path("/run/gts9wifi-fingerprint/active")
TTL_US = 2_000_000


def light_request_matches(contents, token, now):
    return (
        0 < token <= now < token + 1_000_000
        and contents == f"prepare {token}\n"
    )


def active_lease_fresh(contents, now):
    fields = (contents or "").split()
    if len(fields) < 2 or fields[0] != "active":
        return False
    try:
        expires = int(fields[1])
    except ValueError:
        return False
    return expires > now and expires - now <= 3_100_000


def authorized(uid, requested, active_id, properties):
    return (
        bool(requested)
        and requested == active_id
        and properties.get("Active") is True
        and not properties.get("Remote", True)
        and properties.get("Type") in ("wayland", "x11")
        and properties.get("Class") in ("user", "greeter")
        and properties.get("Seat", ("",))[0] == "seat0"
        and properties.get("User", (-1,))[0] == uid
    )


def lease_text(available, expires):
    return f'{"ready" if available else "blocked"} {expires}\n'


def write_lease(path, text):
    temporary = path.with_suffix(".new")
    with temporary.open("w", encoding="ascii") as stream:
        os.fchmod(stream.fileno(), 0o644)
        stream.write(text)
    temporary.replace(path)


def main():
    import dbus
    import dbus.service
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    name = dbus.service.BusName(NAME, bus, do_not_queue=True)
    daemon = dbus.Interface(
        bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus"),
        "org.freedesktop.DBus",
    )

    class Broker(dbus.service.Object):
        def __init__(self):
            super().__init__(name, PATH)
            self.client = None
            self.clear()
            GLib.timeout_add(250, self.tick)
            bus.add_signal_receiver(
                self.disconnected,
                signal_name="NameOwnerChanged",
                dbus_interface="org.freedesktop.DBus",
                bus_name="org.freedesktop.DBus",
            )
            bus.add_signal_receiver(
                self.session_changed,
                signal_name="PropertiesChanged",
                dbus_interface="org.freedesktop.DBus.Properties",
                bus_name="org.freedesktop.login1",
            )
            bus.add_signal_receiver(
                self.session_removed,
                signal_name="SessionRemoved",
                dbus_interface="org.freedesktop.login1.Manager",
                bus_name="org.freedesktop.login1",
            )

        def clear(self):
            self.client = None
            LEASE.unlink(missing_ok=True)
            PRESENTED.unlink(missing_ok=True)

        def active(self):
            seat = dbus.Interface(
                bus.get_object(
                    "org.freedesktop.login1",
                    "/org/freedesktop/login1/seat/seat0",
                    introspect=False,
                ),
                "org.freedesktop.DBus.Properties",
            )
            session, path = seat.Get(
                "org.freedesktop.login1.Seat", "ActiveSession", timeout=1
            )
            if not session:
                return "", {}
            proxy = dbus.Interface(
                bus.get_object(
                    "org.freedesktop.login1", path, introspect=False
                ),
                "org.freedesktop.DBus.Properties",
            )
            props = dict(
                proxy.GetAll("org.freedesktop.login1.Session", timeout=1)
            )
            props["Active"] = bool(props.get("Active"))
            return str(session), props

        @dbus.service.method(
            NAME, in_signature="sb", out_signature="", sender_keyword="sender"
        )
        def Pulse(self, session, available, sender=None):
            uid = int(daemon.GetConnectionUnixUser(sender, timeout=1))
            active_id, props = self.active()
            if not authorized(uid, str(session), active_id, props):
                raise dbus.exceptions.DBusException(
                    "Not the active local session",
                    name=NAME + ".NotActiveSession",
                )
            expires = time.monotonic_ns() // 1000 + TTL_US
            write_lease(LEASE, lease_text(bool(available), expires))
            self.client = (str(sender), uid, str(session), expires)
            if not available:
                PRESENTED.unlink(missing_ok=True)

        @dbus.service.method(
            NAME, in_signature="st", out_signature="", sender_keyword="sender"
        )
        def Presented(self, session, token, sender=None):
            uid = int(daemon.GetConnectionUnixUser(sender, timeout=1))
            active_id, props = self.active()
            now = time.monotonic_ns() // 1000
            if not authorized(uid, str(session), active_id, props):
                raise dbus.exceptions.DBusException(
                    "Not the active local session",
                    name=NAME + ".NotActiveSession",
                )
            if not self.client or self.client[:3] != (
                str(sender),
                uid,
                str(session),
            ):
                raise dbus.exceptions.DBusException(
                    "No current availability lease",
                    name=NAME + ".NoLease",
                )
            try:
                request = LIGHT_REQUEST.read_text(encoding="ascii")
                available = LEASE.read_text(encoding="ascii").startswith(
                    "ready "
                )
            except (OSError, UnicodeError):
                return
            token = int(token)
            if (
                not available
                or now >= self.client[3]
                or not light_request_matches(request, token, now)
            ):
                return
            write_lease(PRESENTED, lease_text(True, token + 1_000_000))

        @dbus.service.method(
            NAME, in_signature="s", out_signature="", sender_keyword="sender"
        )
        def Cancel(self, session, sender=None):
            uid = int(daemon.GetConnectionUnixUser(sender, timeout=1))
            active_id, props = self.active()
            if not authorized(uid, str(session), active_id, props):
                raise dbus.exceptions.DBusException(
                    "Not the active local session",
                    name=NAME + ".NotActiveSession",
                )
            if not self.client or self.client[:3] != (
                str(sender),
                uid,
                str(session),
            ):
                raise dbus.exceptions.DBusException(
                    "No current availability lease",
                    name=NAME + ".NoLease",
                )
            now = time.monotonic_ns() // 1000
            try:
                active = ACTIVE_LEASE.read_text(encoding="ascii")
            except (OSError, UnicodeError):
                return
            if not active_lease_fresh(active, now):
                return
            write_lease(CANCEL, f"cancel {now}\n")
            LEASE.unlink(missing_ok=True)
            PRESENTED.unlink(missing_ok=True)

        def disconnected(self, sender, old_owner, new_owner):
            if sender == "org.freedesktop.login1" and old_owner:
                self.clear()
            if (
                self.client
                and sender == self.client[0]
                and old_owner
                and not new_owner
            ):
                self.clear()

        def session_removed(self, session, _path):
            if self.client and session == self.client[2]:
                self.clear()

        def session_changed(self, interface, changed, invalidated):
            relevant = {
                "org.freedesktop.login1.Seat": {"ActiveSession"},
                "org.freedesktop.login1.Session": {
                    "Active",
                    "Remote",
                    "Type",
                    "Class",
                    "Seat",
                    "User",
                },
            }.get(str(interface), set())
            if relevant.intersection(set(changed) | set(invalidated)):
                self.revalidate()

        def revalidate(self):
            if not self.client:
                return
            _, uid, session, expires = self.client
            try:
                active_id, props = self.active()
                if (
                    time.monotonic_ns() // 1000 >= expires
                    or not authorized(uid, session, active_id, props)
                ):
                    self.clear()
            except dbus.DBusException:
                self.clear()

        def tick(self):
            # Pulses check the sender UID and live logind properties.  The
            # local timer only enforces the unchanged two-second lease.
            if (
                self.client
                and time.monotonic_ns() // 1000 >= self.client[3]
            ):
                self.clear()
            return GLib.SOURCE_CONTINUE

    broker = Broker()
    GLib.MainLoop().run()
    return broker


if __name__ == "__main__":
    main()
