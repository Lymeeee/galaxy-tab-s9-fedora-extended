#!/usr/bin/env python3
# The WCN6855 BD address is unit-specific and lives in Samsung's EFS,
# but the boot images are generic, so the shipped DTBs cannot carry it.
# hci_qca applies a local-bd-address DT property during every controller
# setup (HCI_QUIRK_USE_BDADDR_PROPERTY), which makes the kernel bring the
# controller up already configured with the native address on every boot
# and every re-registration, with no userspace involved. Patch the
# property into both DTB copies on disk: the vendor_boot dtb field (the copy
# ABL currently loads) and the DTB appended to the kernel in boot. Idempotent;
# runs every boot so a reflashed boot image gets re-provisioned on its first
# boot. The EFS address is cached in /var/lib/gts9wifi/bt-address for the
# updater and for boots where EFS cannot be mounted. Partition I/O uses
# pread/pwrite and is read back: buffered writes to the boot partition were
# silently lost.

import os
import re
import struct
import subprocess
import sys
import tempfile
import time

EFS = '/dev/disk/by-partlabel/efs'
BOOT = '/dev/disk/by-partlabel/boot'
VENDOR_BOOT = '/dev/disk/by-partlabel/vendor_boot'
CACHE = '/var/lib/gts9wifi/bt-address'
NODE = '/soc@0/geniqup@8c0000/serial@898000/bluetooth'
PROP = 'local-bd-address'
FDT_MAGIC = b'\xd0\x0d\xfe\xed'
PAGE = 4096
ADDR_RE = re.compile('([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$')


def page_align(n):
    return (n + PAGE - 1) // PAGE * PAGE


def parse_address(text):
    addr = text.strip()
    if not ADDR_RE.fullmatch(addr):
        return None
    # the DT property is little-endian per the binding
    return bytes.fromhex(addr.replace(':', ''))[::-1]


def cache_address(addr):
    try:
        with open(CACHE) as f:
            if f.read().strip() == addr:
                return
    except OSError:
        pass
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix='.bt-address.',
                                   dir=os.path.dirname(CACHE))
        try:
            with os.fdopen(fd, 'w') as f:
                f.write(addr + '\n')
                f.flush()
                os.fsync(f.fileno())
            os.chmod(tmp, 0o644)
            os.replace(tmp, CACHE)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
    except OSError as error:
        print('bt-provision: cannot cache address: %s' % error,
              file=sys.stderr)


def read_efs_address():
    addr = None
    try:
        with tempfile.TemporaryDirectory(dir='/run') as mnt:
            subprocess.run(['mount', '-o', 'ro,noload', EFS, mnt], check=True)
            try:
                with open(os.path.join(mnt, 'bluetooth/bt_addr')) as f:
                    addr = f.read().strip()
            finally:
                subprocess.run(['umount', mnt], check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        print('bt-provision: reading EFS failed (%s); trying %s' %
              (error, CACHE), file=sys.stderr)
    bdaddr = parse_address(addr) if addr else None
    if bdaddr is not None:
        cache_address(addr)
        return bdaddr
    try:
        with open(CACHE) as f:
            addr = f.read()
    except OSError as error:
        sys.exit('no usable EFS address and no cache: %s' % error)
    bdaddr = parse_address(addr)
    if bdaddr is None:
        sys.exit('invalid cached address in %s: %r' % (CACHE, addr.strip()))
    return bdaddr


def patch_dtb(dtb, bdaddr):
    fd, path = tempfile.mkstemp(dir='/run')
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(dtb)
        got = subprocess.run(['fdtget', '-t', 'bx', path, NODE, PROP],
                             capture_output=True, text=True)
        if got.returncode == 0 and \
                bytes(int(v, 16) for v in got.stdout.split()) == bdaddr:
            return None
        subprocess.run(['fdtput', '-t', 'bx', path, NODE, PROP] +
                       ['%02x' % b for b in bdaddr], check=True)
        with open(path, 'rb') as f:
            return f.read()
    finally:
        os.unlink(path)


def find_appended_dtb(kernel, ksize):
    """Return the last FDT in the kernel section, allowing NUL padding."""
    off = ksize
    while True:
        off = kernel.rfind(FDT_MAGIC, 0, off)
        if off < 0:
            return None
        if off + 8 <= ksize:
            totalsize = struct.unpack_from('>I', kernel, off + 4)[0]
            if 8 <= totalsize <= ksize - off and \
                    not any(kernel[off + totalsize:ksize]):
                return off


def pread_exact(fd, size, offset, label):
    data = os.pread(fd, size, offset)
    if len(data) != size:
        sys.exit('%s: short read at %d' % (label, offset))
    return data


def pwrite_all(fd, data, offset, label):
    written = os.pwrite(fd, data, offset)
    if written != len(data):
        sys.exit('%s: short write at %d' % (label, offset))


def provision_boot(bdaddr):
    fd = os.open(BOOT, os.O_RDWR)
    try:
        head = pread_exact(fd, PAGE, 0, 'boot')
        if head[:8] != b'ANDROID!':
            sys.exit('boot: bad magic')
        ksize = struct.unpack_from('<I', head, 8)[0]
        kernel = pread_exact(fd, ksize, PAGE, 'boot')
        off = find_appended_dtb(kernel, ksize)
        if off is None:
            sys.exit('boot: no appended dtb')
        dtb = patch_dtb(kernel[off:], bdaddr)
        if dtb is None:
            return False
        new_end = off + len(dtb)
        if new_end > ksize and page_align(new_end) != page_align(ksize):
            sys.exit('boot: patched dtb would move the ramdisk')
        size = os.lseek(fd, 0, os.SEEK_END)
        if PAGE + new_end > size - PAGE:
            sys.exit('boot: patched dtb does not fit the partition')
        pwrite_all(fd, dtb, PAGE + off, 'boot')
        if new_end <= ksize:
            pad = ksize - new_end
            if pad:
                pwrite_all(fd, b'\x00' * pad, PAGE + new_end, 'boot')
        else:
            pwrite_all(fd, struct.pack('<I', new_end), 8, 'boot')
            if struct.unpack('<I', pread_exact(fd, 4, 8, 'boot'))[0] != new_end:
                sys.exit('boot: kernel size write did not stick')
        if pread_exact(fd, len(dtb), PAGE + off, 'boot') != dtb:
            sys.exit('boot: dtb write did not stick')
        os.fsync(fd)
    finally:
        os.close(fd)
    return True


def provision_vendor_boot(bdaddr):
    fd = os.open(VENDOR_BOOT, os.O_RDWR)
    try:
        head = pread_exact(fd, PAGE, 0, 'vendor_boot')
        if head[:8] != b'VNDRBOOT':
            sys.exit('vendor_boot: bad magic')
        vrsize = struct.unpack_from('<I', head, 24)[0]
        hsize, dtb_size = struct.unpack_from('<II', head, 2096)
        dtb_off = page_align(hsize) + page_align(vrsize)
        # the ramdisk table and bootconfig sit right after the dtb pages;
        # the patched dtb must stay inside the same page envelope
        envelope = page_align(dtb_size)
        old = pread_exact(fd, dtb_size, dtb_off, 'vendor_boot')
        if old[:4] != FDT_MAGIC:
            sys.exit('vendor_boot: no dtb at %d' % dtb_off)
        dtb = patch_dtb(old, bdaddr)
        if dtb is None:
            return False
        if len(dtb) > envelope:
            sys.exit('vendor_boot: patched dtb does not fit its envelope')
        pwrite_all(fd, dtb + b'\x00' * (envelope - len(dtb)), dtb_off,
                   'vendor_boot')
        pwrite_all(fd, struct.pack('<I', len(dtb)), 2100, 'vendor_boot')
        if pread_exact(fd, len(dtb), dtb_off, 'vendor_boot') != dtb:
            sys.exit('vendor_boot: dtb write did not stick')
        if struct.unpack('<I',
                         pread_exact(fd, 4, 2100, 'vendor_boot'))[0] != len(dtb):
            sys.exit('vendor_boot: dtb size write did not stick')
        os.fsync(fd)
    finally:
        os.close(fd)
    return True


def live_matches(bdaddr):
    try:
        with open('/sys/firmware/devicetree/base' + NODE + '/' + PROP,
                  'rb') as f:
            return f.read() == bdaddr
    except OSError:
        return False


def main():
    if os.geteuid() != 0:
        sys.exit('must run as root')
    for _ in range(100):
        if all(os.path.exists(p) for p in (EFS, BOOT, VENDOR_BOOT)):
            break
        time.sleep(0.1)
    bdaddr = read_efs_address()

    def attempt(label, fn):
        try:
            return fn(bdaddr)
        except (SystemExit, Exception) as error:
            print('%s: %s' % (label, error), file=sys.stderr)
            return None

    # vendor_boot carries the DTB that ABL actually uses; do it first and
    # never let a failure on the other copy hide this one.
    vendor = attempt('vendor_boot', provision_vendor_boot)
    boot = attempt('boot', provision_boot)
    if vendor is None:
        sys.exit('vendor_boot provisioning failed')
    if vendor or boot:
        print('native Bluetooth address provisioned; reboot to apply')
    elif not live_matches(bdaddr):
        print('boot DTBs already provisioned; reboot still pending')


if __name__ == '__main__':
    main()
