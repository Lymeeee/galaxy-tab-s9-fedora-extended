#!/usr/bin/env python3
# The WCN6855 BD address is unit-specific and lives in Samsung's EFS,
# but the boot images are generic, so the shipped DTBs cannot carry it.
# hci_qca applies a local-bd-address DT property during every controller
# setup (HCI_QUIRK_USE_BDADDR_PROPERTY), which makes the kernel bring the
# controller up already configured with the native address on every boot
# and every re-registration, with no userspace involved. Patch the
# property into both DTB copies on disk: the vendor_boot dtb field (the copy
# ABL currently loads) and the DTB appended to the kernel in boot. Idempotent;
# runs every boot so a reflashed boot image gets re-provisioned on its first
# boot.

import os
import re
import struct
import subprocess
import sys
import tempfile
import time

EFS = '/dev/disk/by-partlabel/efs'
BOOT = '/dev/disk/by-partlabel/boot'
VENDOR_BOOT = '/dev/disk/by-partlabel/vendor_boot'
NODE = '/soc@0/geniqup@8c0000/serial@898000/bluetooth'
PROP = 'local-bd-address'
FDT_MAGIC = b'\xd0\x0d\xfe\xed'
PAGE = 4096


def page_align(n):
    return (n + PAGE - 1) // PAGE * PAGE


def read_efs_address():
    with tempfile.TemporaryDirectory(dir='/run') as mnt:
        subprocess.run(['mount', '-o', 'ro,noload', EFS, mnt], check=True)
        try:
            with open(os.path.join(mnt, 'bluetooth/bt_addr')) as f:
                addr = f.read().strip()
        finally:
            subprocess.run(['umount', mnt], check=True)
    if not re.fullmatch('([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}', addr):
        sys.exit('invalid address in EFS: %r' % addr)
    # the DT property is little-endian per the binding
    return bytes.fromhex(addr.replace(':', ''))[::-1]


def patch_dtb(dtb, bdaddr):
    fd, path = tempfile.mkstemp(dir='/run')
    try:
        os.write(fd, dtb)
        os.close(fd)
        got = subprocess.run(['fdtget', '-t', 'bx', path, NODE, PROP],
                             capture_output=True, text=True)
        if got.returncode == 0 and \
                bytes(int(v, 16) for v in got.stdout.split()) == bdaddr:
            return None
        subprocess.run(['fdtput', '-t', 'bx', path, NODE, PROP] +
                       ['%02x' % b for b in bdaddr], check=True)
        with open(path, 'rb') as f:
            return f.read()
    finally:
        os.unlink(path)


def find_appended_dtb(kernel, ksize):
    """Return the last FDT in the kernel section, allowing NUL padding."""
    off = ksize
    while True:
        off = kernel.rfind(FDT_MAGIC, 0, off)
        if off < 0:
            return None
        if off + 8 <= ksize:
            totalsize = struct.unpack_from('>I', kernel, off + 4)[0]
            if 8 <= totalsize <= ksize - off and \
                    not any(kernel[off + totalsize:ksize]):
                return off


def provision_boot(bdaddr):
    with open(BOOT, 'r+b') as part:
        head = bytearray(part.read(PAGE))
        if head[:8] != b'ANDROID!':
            sys.exit('boot: bad magic')
        ksize = struct.unpack_from('<I', head, 8)[0]
        part.seek(PAGE)
        kernel = part.read(ksize)
        off = find_appended_dtb(kernel, ksize)
        if off is None:
            sys.exit('boot: no appended dtb')
        dtb = patch_dtb(kernel[off:], bdaddr)
        if dtb is None:
            return False
        new_end = off + len(dtb)
        if new_end > ksize and page_align(new_end) != page_align(ksize):
            sys.exit('boot: patched dtb would move the ramdisk')
        size = os.lseek(part.fileno(), 0, os.SEEK_END)
        if PAGE + new_end > size - PAGE:
            sys.exit('boot: patched dtb does not fit the partition')
        part.seek(PAGE + off)
        part.write(dtb)
        if new_end <= ksize:
            part.write(b'\x00' * (ksize - new_end))
        else:
            struct.pack_into('<I', head, 8, new_end)
            part.seek(0)
            part.write(head)
        part.flush()
        os.fsync(part.fileno())
    return True


def provision_vendor_boot(bdaddr):
    with open(VENDOR_BOOT, 'r+b') as part:
        head = bytearray(part.read(PAGE))
        if head[:8] != b'VNDRBOOT':
            sys.exit('vendor_boot: bad magic')
        vrsize = struct.unpack_from('<I', head, 24)[0]
        hsize, dtb_size = struct.unpack_from('<II', head, 2096)
        dtb_off = page_align(hsize) + page_align(vrsize)
        # the ramdisk table and bootconfig sit right after the dtb pages;
        # the patched dtb must stay inside the same page envelope
        envelope = page_align(dtb_size)
        part.seek(dtb_off)
        old = part.read(dtb_size)
        if old[:4] != FDT_MAGIC:
            sys.exit('vendor_boot: no dtb at %d' % dtb_off)
        dtb = patch_dtb(old, bdaddr)
        if dtb is None:
            return False
        if len(dtb) > envelope:
            sys.exit('vendor_boot: patched dtb does not fit its envelope')
        part.seek(dtb_off)
        part.write(dtb + b'\x00' * (envelope - len(dtb)))
        struct.pack_into('<I', head, 2100, len(dtb))
        part.seek(0)
        part.write(head)
        part.flush()
        os.fsync(part.fileno())
    return True


def live_matches(bdaddr):
    try:
        with open('/sys/firmware/devicetree/base' + NODE + '/' + PROP,
                  'rb') as f:
            return f.read() == bdaddr
    except OSError:
        return False


def main():
    if os.geteuid() != 0:
        sys.exit('must run as root')
    for _ in range(100):
        if all(os.path.exists(p) for p in (EFS, BOOT, VENDOR_BOOT)):
            break
        time.sleep(0.1)
    bdaddr = read_efs_address()

    def attempt(label, fn):
        try:
            return fn(bdaddr)
        except (SystemExit, Exception) as error:
            print('%s: %s' % (label, error), file=sys.stderr)
            return None

    # vendor_boot carries the DTB that ABL actually uses; do it first and
    # never let a failure on the other copy hide this one.
    vendor = attempt('vendor_boot', provision_vendor_boot)
    boot = attempt('boot', provision_boot)
    if vendor is None:
        sys.exit('vendor_boot provisioning failed')
    if vendor or boot:
        print('native Bluetooth address provisioned; reboot to apply')
    elif not live_matches(bdaddr):
        print('boot DTBs already provisioned; reboot still pending')


if __name__ == '__main__':
    main()
