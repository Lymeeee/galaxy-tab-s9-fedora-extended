[Unit]
Description=Restore file capabilities dropped by rootfs tar extraction
ConditionPathExists=/usr/bin/rpm
ConditionPathExists=/usr/bin/setcap
After=local-fs.target
Before=multi-user.target sssd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/gts9wifi-filecaps-restore
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
