Subject: [PATCH] tty: serial: qcom-geni-serial: force runtime suspend during system suspend

qcom_geni_serial_pm() relies on pm_runtime_put_sync(uport->dev) to
invoke qcom_geni_serial_runtime_suspend() -> geni_serial_resources_off()
and disable the SE clock and interconnect votes when a UART port is
suspended via uart_suspend_port().

However, during system sleep dpm_prepare() holds an extra runtime PM
reference on every device (usage_count >= 1).  As a result,
pm_runtime_put_sync() inside uart_suspend_port() only decrements
usage_count from 2 to 1 and never triggers qcom_geni_serial_runtime_suspend().
Because qcom_geni_serial_suspend() does not call pm_runtime_force_suspend(),
any active GENI UART (such as the QCA6490/WCN6855 Bluetooth UART on
SM8550) keeps its SE clock (gcc_qupv3_wrap2_s6_clk -> gcc_gpll0 ->
bi_tcxo) enabled across PM_SUSPEND_MEM, blocking CXSD/AOSD/DDR deep sleep
collapse.

Call pm_runtime_force_suspend() after uart_suspend_port() in
qcom_geni_serial_suspend() (unless the port is a console with
no_console_suspend), and call pm_runtime_force_resume() before
uart_resume_port() in qcom_geni_serial_resume() so runtime PM is
re-enabled before qcom_geni_serial_pm(UART_PM_STATE_ON) runs.

---
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -1975,6 +1975,7 @@ static int qcom_geni_serial_suspend(struct device *dev)
 	struct qcom_geni_serial_port *port = dev_get_drvdata(dev);
 	struct uart_port *uport = &port->uport;
 	struct qcom_geni_private_data *private_data = uport->private_data;
+	int ret;
 
 	/*
 	 * This is done so we can hit the lowest possible state in suspend
@@ -1984,7 +1985,14 @@ static int qcom_geni_serial_suspend(struct device *dev)
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ACTIVE_ONLY);
 		geni_icc_set_bw(&port->se);
 	}
-	return uart_suspend_port(private_data->drv, uport);
+	ret = uart_suspend_port(private_data->drv, uport);
+	if (ret)
+		return ret;
+
+	if (!uart_console(uport) || console_suspend_enabled)
+		ret = pm_runtime_force_suspend(dev);
+
+	return ret;
 }
 
 static int qcom_geni_serial_resume(struct device *dev)
@@ -1994,6 +2002,12 @@ static int qcom_geni_serial_resume(struct device *dev)
 	struct uart_port *uport = &port->uport;
 	struct qcom_geni_private_data *private_data = uport->private_data;
 
+	if (!uart_console(uport) || console_suspend_enabled) {
+		ret = pm_runtime_force_resume(dev);
+		if (ret)
+			return ret;
+	}
+
 	ret = uart_resume_port(private_data->drv, uport);
 	if (uart_console(uport)) {
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ALWAYS);
